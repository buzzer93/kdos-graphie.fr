{% extends 'base.html.twig' %}

{% block title %}Validation commande — Kdos Graphie{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50 text-neutral-800">
    <header class="bg-white border-b border-neutral-200">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
            <div class="flex items-center gap-6">
                <a href="{{ path('app_home') }}" class="flex items-center gap-2">
                    <img src="{{ asset('media/LOGO Kdos-graphie.svg') }}" alt="Kdos Graphie" class="h-8 w-auto">
                </a>
                <a href="{{ path('app_cart_index') }}" class="text-sm text-neutral-600 hover:text-neutral-900 transition">← Panier</a>
            </div>
            <span class="text-sm text-neutral-500">Finalisation de la commande</span>
        </div>
    </header>
    <main class="max-w-7xl mx-auto px-6 py-10 grid lg:grid-cols-2 gap-8">
        <section class="bg-white border border-neutral-200 rounded-xl p-6 space-y-4">
            <h1 class="font-display text-3xl text-neutral-900">Finaliser ma demande</h1>
            {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
                <div>
                    {{ form_label(form.customerFirstName, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1'}}) }}
                    {{ form_widget(form.customerFirstName, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
                    {{ form_errors(form.customerFirstName) }}
                </div>
                <div>
                    {{ form_label(form.customerLastName, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1'}}) }}
                    {{ form_widget(form.customerLastName, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
                    {{ form_errors(form.customerLastName) }}
                </div>
                <div>
                    {{ form_label(form.customerEmail, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1'}}) }}
                    {{ form_widget(form.customerEmail, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
                    {{ form_errors(form.customerEmail) }}
                </div>
                <div>
                    {{ form_label(form.customerPhone, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1'}}) }}
                    {{ form_widget(form.customerPhone, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
                    {{ form_errors(form.customerPhone) }}
                </div>
                <div>
                    {{ form_label(form.shippingAddress, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1'}}) }}
                    {{ form_widget(form.shippingAddress, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg min-h-24'}}) }}
                    {{ form_errors(form.shippingAddress) }}
                </div>
                <div>
                    {{ form_label(form.additionalInfo, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1'}}) }}
                    {{ form_widget(form.additionalInfo, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg min-h-20'}}) }}
                    {{ form_errors(form.additionalInfo) }}
                </div>
                <div class="flex items-center gap-3 pt-2">
                    <button class="bg-neutral-900 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-neutral-700" type="submit">Envoyer ma demande</button>
                    <a href="{{ path('app_cart_index') }}" class="text-sm text-neutral-600 hover:text-neutral-900">Retour à ma demande</a>
                </div>
            {{ form_end(form) }}
        </section>

        <aside class="bg-white border border-neutral-200 rounded-xl p-6 space-y-4">
            <h2 class="font-semibold text-neutral-900">Recapitulatif</h2>
            <div class="space-y-3">
                {% for line in lines %}
                    <div class="border border-neutral-100 rounded-lg p-3">
                        <p class="font-medium text-neutral-900">{{ line.productName }}</p>
                        {% if line.optionsSummary is defined and line.optionsSummary %}
                            <p class="text-sm text-neutral-500">{{ line.optionsSummary }}</p>
                        {% endif %}
                        <p class="text-sm text-neutral-600">Qté {{ line.quantity }} · {{ (line.unitPrice / 100)|number_format(2, ',', ' ') }} €</p>
                        {% if line.customizationText %}
                            <p class="text-sm text-neutral-700 mt-1">Texte à graver : {{ line.customizationText }}</p>
                        {% endif %}
                        {% if line.specialRequest is defined and line.specialRequest %}
                            <p class="text-sm text-amber-700 mt-1">Demande particulière : {{ line.specialRequest }}</p>
                        {% endif %}
                        {% if line.customizationFilePath %}
                            <p class="text-sm text-neutral-700 mt-1">Fichier de personnalisation joint</p>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
            <p class="text-xl font-semibold text-neutral-900">Estimation : {{ (totalCents / 100)|number_format(2, ',', ' ') }} €</p>
            <p class="text-sm text-neutral-500">Le prix final sera confirmé par l'atelier après étude de votre demande.</p>
        </aside>
    </main>
</div>
{% endblock %}
