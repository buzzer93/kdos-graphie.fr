{% extends 'emails/_layout.html.twig' %}

{% block email_title %}Votre devis Kdos Graphie — {{ order.reference }}{% endblock %}

{% block email_body %}
<h1>Votre devis est prêt</h1>

<p>Bonjour {{ order.customerFirstName }},</p>

<p>Nous avons étudié votre demande de personnalisation et vous adressons le devis correspondant.</p>

<div class="reference-block">
    <div class="label">Référence commande</div>
    <div class="value">{{ order.reference }}</div>
</div>

{% if order.quoteDescription %}
<div style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:16px;margin:20px 0">
    <div style="font-size:12px;color:#92400e;font-weight:600;margin-bottom:6px;text-transform:uppercase;letter-spacing:0.05em">Personnalisation prévue</div>
    <p style="margin:0;font-size:15px;color:#78350f">{{ order.quoteDescription }}</p>
</div>
{% endif %}

{% if order.items is not empty %}
<table class="order-table">
    <thead>
        <tr>
            <th>Produit</th>
            <th style="text-align:right">Qté</th>
        </tr>
    </thead>
    <tbody>
        {% for item in order.items %}
        <tr>
            <td>
                {{ item.productName }}
                {% if item.optionsSummary %}<br><small style="color:#6b7280">{{ item.optionsSummary }}</small>{% endif %}
                {% if item.customizationText %}<br><small style="color:#6b7280">Texte : {{ item.customizationText }}</small>{% endif %}
                {% if item.specialRequest %}<br><small style="color:#92400e">Demande : {{ item.specialRequest }}</small>{% endif %}
            </td>
            <td style="text-align:right">{{ item.quantity }}</td>
        </tr>
        {% endfor %}
        <tr class="total-row">
            <td colspan="1">Montant du devis</td>
            <td style="text-align:right">{{ (order.quotedPrice / 100)|number_format(2, ',', ' ') }} €</td>
        </tr>
    </tbody>
</table>
{% endif %}

<p>Pour valider ce devis, procédez au paiement sécurisé en cliquant sur le bouton ci-dessous :</p>

{% if order.paymentLink %}
<p style="text-align:center;margin:24px 0">
    <a href="{{ order.paymentLink }}"
       style="display:inline-block;background-color:#d97706;color:#ffffff;text-decoration:none;font-weight:600;font-size:15px;padding:14px 28px;border-radius:10px;">
        Payer {{ (order.quotedPrice / 100)|number_format(2, ',', ' ') }} € et valider ma commande
    </a>
</p>
<p style="font-size:13px;color:#6b7280">
    Ou copiez ce lien dans votre navigateur :<br>
    <a href="{{ order.paymentLink }}" style="color:#d97706;word-break:break-all;">{{ order.paymentLink }}</a>
</p>
{% endif %}

<p>Ce devis est valable jusqu'à confirmation de votre règlement. Pour toute question, vous pouvez nous répondre directement à cet email.</p>

<p>À très bientôt,<br><strong>L'équipe Kdos-Graphie</strong></p>
{% endblock %}
