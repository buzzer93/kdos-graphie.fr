<h1>Commande terminee</h1>
<p>Bonjour {{ order.customerFullName }},</p>
<p>Votre commande <strong>{{ order.reference }}</strong> est terminee.</p>
{% if order.shippingCarrier or order.trackingNumber %}
    <p>Informations de livraison:</p>
    <ul>
        {% if order.shippingCarrier %}<li>Transporteur: {{ order.shippingCarrier }}</li>{% endif %}
        {% if order.trackingNumber %}<li>Numero de suivi: {{ order.trackingNumber }}</li>{% endif %}
    </ul>
{% endif %}
