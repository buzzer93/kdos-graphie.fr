{% extends 'emails/_layout.html.twig' %}

{% block email_title %}Commande confirmée — {{ order.reference }}{% endblock %}

{% block email_body %}
<h1>Votre commande est confirmée</h1>

<p>Bonjour {{ order.customerFirstName }},</p>

<p>Bonne nouvelle ! Notre atelier a étudié votre demande et confirme la prise en charge de votre commande.</p>

<div class="reference-block">
    <div class="label">Référence commande</div>
    <div class="value">{{ order.reference }}</div>
</div>

<p>Vous pouvez procéder au paiement sécurisé de votre commande en cliquant sur le bouton ci-dessous :</p>

{% if order.paymentLink %}
<p style="text-align:center;margin:24px 0">
    <a href="{{ order.paymentLink }}"
       style="display:inline-block;background-color:#171717;color:#ffffff;text-decoration:none;font-weight:600;font-size:15px;padding:14px 28px;border-radius:10px;">
        Payer {{ order.formattedTotal }}
    </a>
</p>
<p style="font-size:13px;color:#6b7280">
    Ou copiez ce lien dans votre navigateur :<br>
    <a href="{{ order.paymentLink }}" style="color:#d97706;word-break:break-all;">{{ order.paymentLink }}</a>
</p>
{% endif %}

{% if order.items is not empty %}
<table class="order-table">
    <thead>
        <tr>
            <th>Produit</th>
            <th style="text-align:right">Qté</th>
            <th style="text-align:right">Prix unit.</th>
        </tr>
    </thead>
    <tbody>
        {% for item in order.items %}
        <tr>
            <td>{{ item.productName }}</td>
            <td style="text-align:right">{{ item.quantity }}</td>
            <td style="text-align:right">{{ (item.unitPrice / 100)|number_format(2, ',', ' ') }} €</td>
        </tr>
        {% endfor %}
        <tr class="total-row">
            <td colspan="2">Total à régler</td>
            <td style="text-align:right">{{ order.formattedTotal }}</td>
        </tr>
    </tbody>
</table>
{% endif %}

<p>Pour toute question, vous pouvez nous répondre directement à cet email.</p>

<p>À très bientôt,<br><strong>L'équipe Kdos-Graphie</strong></p>
{% endblock %}
