{% extends 'base.html.twig' %}

{% block title %}Connexion — KDOS-GRAPHIE{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">

        <div class="text-center mb-8">
            <img src="{{ asset('media/LOGO Kdos-graphie.svg') }}" alt="KDOS-GRAPHIE" class="h-10 mx-auto mb-5">
            <h1 class="font-display text-2xl font-semibold text-neutral-900 tracking-tight">Espace administrateur</h1>
            <p class="text-sm text-neutral-500 mt-1.5">Connectez-vous pour accéder au tableau de bord</p>
        </div>

        <div class="bg-white rounded-[20px] px-8 py-8"
             style="box-shadow: rgba(0,0,0,0.02) 0px 0px 0px 1px, rgba(0,0,0,0.04) 0px 2px 6px, rgba(0,0,0,0.1) 0px 4px 8px;">

            {% if error %}
                <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg mb-6 flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="space-y-5" data-turbo="false">

                <div>
                    <label for="inputEmail" class="block text-sm font-medium text-neutral-700 mb-1.5">
                        Email
                    </label>
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="email"
                        id="inputEmail"
                        autocomplete="email"
                        required
                        autofocus
                        placeholder="votre@email.com"
                        class="w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm text-neutral-900 placeholder-neutral-400 transition
                               focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent"
                    >
                </div>

                <div>
                    <label for="inputPassword" class="block text-sm font-medium text-neutral-700 mb-1.5">
                        Mot de passe
                    </label>
                    <input
                        type="password"
                        name="password"
                        id="inputPassword"
                        autocomplete="current-password"
                        required
                        placeholder="••••••••"
                        class="w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm text-neutral-900 placeholder-neutral-400 transition
                               focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent"
                    >
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button
                    type="submit"
                    class="w-full bg-neutral-900 hover:bg-amber-500 text-white text-sm font-medium py-3 px-6 rounded-lg transition-colors duration-200 mt-2"
                >
                    Se connecter
                </button>

            </form>
        </div>

        <p class="text-center text-xs text-neutral-400 mt-6 space-x-3">
            <a href="{{ path('app_home') }}" class="hover:text-neutral-600 transition-colors">← Retour au site</a>
            <span>·</span>
            <a href="{{ path('app_reset_password_request') }}" class="hover:text-neutral-600 transition-colors">Mot de passe oublié ?</a>
        </p>

    </div>
</div>
{% endblock %}
