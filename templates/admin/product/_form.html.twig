{{ form_start(form, {attr: {class: 'space-y-5'}}) }}
    <div>
        {{ form_label(form.name, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
        {{ form_widget(form.name, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
        {{ form_errors(form.name) }}
    </div>

    <div>
        {{ form_label(form.slug, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
        {{ form_widget(form.slug, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
        {{ form_errors(form.slug) }}
    </div>

    <div class="grid md:grid-cols-2 gap-4">
        <div>
            {{ form_label(form.price, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
            {{ form_widget(form.price, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
            {{ form_errors(form.price) }}
        </div>
        <div>
            {{ form_label(form.stock, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
            {{ form_widget(form.stock, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
            {{ form_errors(form.stock) }}
        </div>
    </div>

    <div>
        {{ form_label(form.category, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
        {{ form_widget(form.category, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
        {{ form_errors(form.category) }}
    </div>

    <div>
        {{ form_label(form.description, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
        {{ form_widget(form.description, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg min-h-24'}}) }}
        {{ form_errors(form.description) }}
    </div>

    <div class="space-y-2">
        {{ form_label(form.coverFile, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700'}}) }}
        {{ form_widget(form.coverFile, {attr: {class: 'w-full px-4 py-2.5 border border-neutral-200 rounded-lg bg-white'}}) }}
        {{ form_errors(form.coverFile) }}
        {% if imagePublicPath %}
            <img src="{{ asset(imagePublicPath) }}" alt="Image produit" class="w-28 h-28 object-cover rounded-lg border border-neutral-200">
        {% endif %}
    </div>

    <label class="flex items-center gap-2 text-sm text-neutral-700">
        {{ form_widget(form.isVisible) }}
        {{ form_label(form.isVisible) }}
    </label>

    <div class="pt-4 border-t border-neutral-200 flex items-center gap-3">
        <button class="bg-neutral-900 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-neutral-700" type="submit">Enregistrer</button>
        <a href="{{ path('app_admin_product_index') }}" class="text-sm text-neutral-600 hover:text-neutral-900">Annuler</a>
    </div>
{{ form_end(form) }}
