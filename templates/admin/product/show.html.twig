{% extends 'admin/base.html.twig' %}

{% block title %}Produit {{ product.name }} — Admin{% endblock %}
{% block page_title %}Détail produit{% endblock %}

{% block header_actions %}
    <a href="{{ path('app_admin_product_edit', {id: product.id}) }}" class="bg-neutral-900 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-neutral-700">Modifier</a>
{% endblock %}

{% block admin_content %}
<div class="bg-white border border-neutral-200 rounded-xl p-6 space-y-3">
    <p><span class="text-neutral-500">Nom:</span> <span class="font-medium">{{ product.name }}</span></p>
    <p><span class="text-neutral-500">Slug:</span> {{ product.slug }}</p>
    <p><span class="text-neutral-500">Prix:</span> {{ (product.price / 100)|number_format(2, ',', ' ') }} €</p>
    <p><span class="text-neutral-500">Stock:</span> {{ product.stock }}</p>
    <p><span class="text-neutral-500">Catégorie:</span> {{ product.category ? product.category.name : '—' }}</p>
    <p><span class="text-neutral-500">Visible:</span> {{ product.isVisible ? 'Oui' : 'Non' }}</p>
    {% if imagePublicPath %}
        <img src="{{ asset(imagePublicPath) }}" alt="{{ product.name }}" class="w-40 h-40 object-cover rounded-lg border border-neutral-200">
    {% endif %}
    <p class="text-neutral-700 whitespace-pre-line">{{ product.description ?: 'Aucune description' }}</p>
</div>
{% endblock %}
