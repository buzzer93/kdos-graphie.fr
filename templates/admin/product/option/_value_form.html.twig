{{ form_start(form, {attr: {class: 'space-y-5'}}) }}
    <div>
        {{ form_label(form.label, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
        {{ form_widget(form.label, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
        {{ form_errors(form.label) }}
    </div>

    <div>
        {{ form_label(form.priceAdjustment, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
        <div class="flex items-center gap-2">
            {{ form_widget(form.priceAdjustment, {attr: {class: 'w-36 px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
            <span class="text-sm text-neutral-500">centimes (ex: 500 = 5,00 €)</span>
        </div>
        {{ form_errors(form.priceAdjustment) }}
    </div>

    <div>
        {{ form_label(form.sortOrder, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
        {{ form_widget(form.sortOrder, {attr: {class: 'w-28 px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
        {{ form_errors(form.sortOrder) }}
    </div>

    <label class="flex items-center gap-2 text-sm text-neutral-700">
        {{ form_widget(form.isActive) }}
        {{ form_label(form.isActive) }}
    </label>

    <div class="pt-4 border-t border-neutral-200 flex items-center gap-3">
        <button class="bg-neutral-900 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-neutral-700" type="submit">Enregistrer</button>
        <a href="{{ path('app_admin_product_edit', {id: product.id}) }}" class="text-sm text-neutral-600 hover:text-neutral-900">Annuler</a>
    </div>
{{ form_end(form) }}
