{% extends 'base.html.twig' %}

{% block body %}
<div class="flex min-h-screen bg-neutral-50">

    {# ── Sidebar ─────────────────────────────────────────────── #}
    {{ include('admin/partials/_sidenav.html.twig') }}

    {# ── Main ─────────────────────────────────────────────────── #}
    <div class="flex-1 ml-64 flex flex-col min-h-screen">

        <header class="h-16 bg-white border-b border-neutral-200 flex items-center justify-between px-8 sticky top-0 z-20">
            <h1 class="text-base font-semibold text-neutral-900">{% block page_title %}{% endblock %}</h1>
            <div class="flex items-center gap-3">
                {% block header_actions %}{% endblock %}
            </div>
        </header>

        <main class="flex-1 p-8">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-lg border px-4 py-3 text-sm {{ label == 'success' ? 'border-green-200 bg-green-50 text-green-700' : 'border-neutral-200 bg-white text-neutral-700' }}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block admin_content %}{% endblock %}
        </main>

    </div>
</div>
{% endblock %}
