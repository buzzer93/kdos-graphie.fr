{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard — KDOS-GRAPHIE{% endblock %}

{% block page_title %}Tableau de bord{% endblock %}

{% block admin_content %}
<div class="space-y-8">

    <p class="text-sm text-neutral-500">Bienvenue, <span class="font-medium text-neutral-700">{{ app.user.userIdentifier }}</span></p>

    {# ── Stats ────────────────────────────────────────────────── #}
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6">
        {% set stats = [
            { label: 'Commandes',  value: '—', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>' },
            { label: 'Produits',   value: '—', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>' },
            { label: 'Clients',    value: '—', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>' },
            { label: 'Revenus',    value: '—', icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>' },
        ] %}

        {% for stat in stats %}
        <div class="bg-white rounded-[20px] p-6 transition-shadow hover:shadow-lg"
             style="box-shadow: rgba(0,0,0,0.02) 0px 0px 0px 1px, rgba(0,0,0,0.04) 0px 2px 6px, rgba(0,0,0,0.1) 0px 4px 8px;">
            <div class="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center mb-4">
                <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    {{ stat.icon|raw }}
                </svg>
            </div>
            <p class="text-2xl font-semibold text-neutral-900">{{ stat.value }}</p>
            <p class="text-sm text-neutral-500 mt-0.5">{{ stat.label }}</p>
        </div>
        {% endfor %}
    </div>

</div>
{% endblock %}
