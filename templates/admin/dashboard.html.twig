{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard — KDOS-GRAPHIE{% endblock %}

{% block page_title %}Tableau de bord{% endblock %}

{% block admin_content %}
<div class="space-y-6">
    <h2 class="text-sm font-medium text-neutral-500 uppercase tracking-wide">Resume commandes actives</h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {% for column in columns|default([]) %}
            <article class="bg-white border border-neutral-200 rounded-xl p-6">
                <p class="text-xs uppercase tracking-wide text-neutral-500">{{ column.label }}</p>
                <p class="mt-2 text-4xl font-semibold text-neutral-900">{{ column.count }}</p>
            </article>
        {% endfor %}
    </div>
</div>
{% endblock %}
