{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard — KDOS-GRAPHIE{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}

{% macro status_card(card) %}
    {% set colors = {
        'orange':  {bg: 'bg-orange-50',  border: 'border-orange-200',  count: 'text-orange-900',  label: 'text-orange-700',  badge: 'bg-orange-100 text-orange-700'},
        'neutral': {bg: 'bg-neutral-50', border: 'border-neutral-200', count: 'text-neutral-900', label: 'text-neutral-500', badge: 'bg-neutral-100 text-neutral-700'},
        'blue':    {bg: 'bg-blue-50',    border: 'border-blue-200',    count: 'text-blue-900',    label: 'text-blue-600',    badge: 'bg-blue-100 text-blue-700'},
        'amber':   {bg: 'bg-amber-50',   border: 'border-amber-200',   count: 'text-amber-900',   label: 'text-amber-700',   badge: 'bg-amber-100 text-amber-700'},
        'green':   {bg: 'bg-green-50',   border: 'border-green-200',   count: 'text-green-900',   label: 'text-green-700',   badge: 'bg-green-100 text-green-700'},
        'red':     {bg: 'bg-red-50',     border: 'border-red-200',     count: 'text-red-900',     label: 'text-red-700',     badge: 'bg-red-100 text-red-700'},
        'rose':    {bg: 'bg-rose-50',    border: 'border-rose-200',    count: 'text-rose-900',    label: 'text-rose-700',    badge: 'bg-rose-100 text-rose-700'},
    } %}
    {% set c = colors[card.color]|default(colors['neutral']) %}
    <a href="{{ path('app_admin_order_index', {status: card.code}) }}"
       class="block {{ c.bg }} border {{ c.border }} rounded-xl p-5 hover:shadow-sm transition-shadow">
        <p class="text-xs font-semibold uppercase tracking-wider {{ c.label }} mb-2">{{ card.label }}</p>
        <p class="text-4xl font-bold {{ c.count }}">{{ card.count }}</p>
        <p class="text-xs {{ c.label }} mt-2">Voir →</p>
    </a>
{% endmacro %}

{% block admin_content %}
<div class="space-y-8">

    {# ── Commandes actives ── #}
    <section>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-3">Commandes actives</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {% for card in activeCards %}
                {{ _self.status_card(card) }}
            {% endfor %}
        </div>
    </section>

    {# ── CA total ── #}
    <section class="bg-white border border-neutral-200 rounded-xl p-6 flex items-center justify-between">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-1">Chiffre d'affaires (hors refusées/annulées)</p>
            <p class="text-3xl font-bold text-neutral-900">
                {{ (revenueCents / 100)|number_format(2, ',', ' ') }} €
            </p>
        </div>
        <a href="{{ path('app_admin_order_index') }}"
           class="text-sm font-medium text-neutral-600 hover:text-neutral-900 border border-neutral-200 px-4 py-2 rounded-lg hover:bg-neutral-50">
            Toutes les commandes
        </a>
    </section>

    {# ── Historique ── #}
    <section>
        <h2 class="text-xs font-semibold uppercase tracking-wider text-neutral-400 mb-3">Historique</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {% for card in archivedCards %}
                {{ _self.status_card(card) }}
            {% endfor %}
        </div>
    </section>

</div>
{% endblock %}
