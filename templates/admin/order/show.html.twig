{% extends 'admin/base.html.twig' %}

{% block title %}Commande {{ order.reference }} — Admin{% endblock %}
{% block page_title %}{{ order.reference }}{% endblock %}

{% block header_actions %}
    <a href="{{ path('app_admin_order_index') }}" class="text-sm text-neutral-600 hover:text-neutral-900">← Retour aux commandes</a>
{% endblock %}

{% block admin_content %}
<div class="space-y-4 max-w-5xl">

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="rounded-lg border px-4 py-3 text-sm {{ type == 'danger' ? 'border-red-200 bg-red-50 text-red-700' : (type == 'warning' ? 'border-amber-200 bg-amber-50 text-amber-700' : 'border-emerald-200 bg-emerald-50 text-emerald-700') }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <div class="bg-white border border-neutral-200 rounded-xl p-6 space-y-5">
        <div class="flex items-center gap-3">
            <h2 class="text-sm font-semibold text-neutral-900">Statut</h2>
            {{ include('admin/partials/_status_badge.html.twig', {status: order.status, label: statusLabels[order.status] ?? order.status}) }}
        </div>

        <div class="grid md:grid-cols-2 gap-4 text-sm">
            <div>
                <p class="text-neutral-500 mb-1">Référence</p>
                <p class="font-medium text-neutral-900">{{ order.reference }}</p>
            </div>
            <div>
                <p class="text-neutral-500 mb-1">Date</p>
                <p class="text-neutral-700">{{ order.createdAt|date('d/m/Y H:i') }}</p>
            </div>
            <div>
                <p class="text-neutral-500 mb-1">Client</p>
                <p class="text-neutral-700">{{ order.customerFullName }}</p>
            </div>
            <div>
                <p class="text-neutral-500 mb-1">Email</p>
                <p class="text-neutral-700">{{ order.customerEmail }}</p>
            </div>
            <div>
                <p class="text-neutral-500 mb-1">Téléphone</p>
                <p class="text-neutral-700">{{ order.customerPhone }}</p>
            </div>
            <div>
                <p class="text-neutral-500 mb-1">Total</p>
                <p class="font-semibold text-neutral-900">{{ order.formattedTotal }}</p>
            </div>
        </div>

        <div class="text-sm">
            <p class="text-neutral-500 mb-1">Adresse de livraison</p>
            <p class="text-neutral-700 whitespace-pre-line">{{ order.shippingAddress }}</p>
        </div>

        {% if order.decisionReason %}
            <div class="text-sm">
                <p class="text-neutral-500 mb-1">Motif de décision</p>
                <p class="text-neutral-700">{{ order.decisionReason }}</p>
            </div>
        {% endif %}

        {% if order.notes %}
            <div class="text-sm">
                <p class="text-neutral-500 mb-1">Notes</p>
                <p class="text-neutral-700 whitespace-pre-line">{{ order.notes }}</p>
            </div>
        {% endif %}
    </div>

    <div class="bg-white border border-neutral-200 rounded-xl p-6">
        <h2 class="text-sm font-semibold text-neutral-900 mb-3">Lignes de commande</h2>
        <table class="min-w-full text-sm">
            <thead class="bg-neutral-50 text-neutral-500">
                <tr>
                    <th class="text-left px-3 py-2">Produit</th>
                    <th class="text-right px-3 py-2">Prix unit.</th>
                    <th class="text-right px-3 py-2">Qté</th>
                    <th class="text-right px-3 py-2">Sous-total</th>
                </tr>
            </thead>
            <tbody>
            {% for item in order.items %}
                <tr class="border-t border-neutral-100">
                    <td class="px-3 py-2 text-neutral-900">{{ item.productName }}</td>
                    <td class="px-3 py-2 text-right text-neutral-600">{{ (item.unitPrice / 100)|number_format(2, ',', ' ') }} €</td>
                    <td class="px-3 py-2 text-right text-neutral-600">{{ item.quantity }}</td>
                    <td class="px-3 py-2 text-right font-medium text-neutral-900">{{ (item.subtotal / 100)|number_format(2, ',', ' ') }} €</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if order.status == 'annule' %}
        <div class="bg-white border border-neutral-200 rounded-xl p-6">
            <h2 class="text-sm font-semibold text-neutral-900 mb-3">Remboursement</h2>

            {% if order.refunded %}
                <div class="text-sm space-y-1 text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg px-4 py-3">
                    <p class="font-medium">Remboursé le {{ order.refundedAt|date('d/m/Y à H:i') }}</p>
                    {% if order.refundNote %}
                        <p>{{ order.refundNote }}</p>
                    {% endif %}
                </div>
            {% elseif order.total > 0 %}
                <p class="text-sm text-neutral-500 mb-4">Cette commande a été annulée et un paiement a pu être effectué. Marquez-la comme remboursée une fois le remboursement Stripe effectué manuellement.</p>
                <form method="post" action="{{ path('app_admin_order_mark_refunded', {id: order.id}) }}" class="space-y-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('mark_refunded_' ~ order.id) }}">
                    <div>
                        <label for="refund_note" class="block text-sm font-medium text-neutral-700 mb-1.5">Note de remboursement (optionnel)</label>
                        <textarea id="refund_note" name="refund_note" rows="2"
                            class="w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm"
                            placeholder="Ex: Remboursé via Stripe le 08/05/2026, montant 34,90 €"></textarea>
                    </div>
                    <button type="submit" class="px-4 py-2.5 rounded-lg bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700">
                        Marquer comme remboursé
                    </button>
                </form>
            {% else %}
                <p class="text-sm text-neutral-500">Aucun paiement associé à cette commande.</p>
            {% endif %}
        </div>
    {% endif %}

</div>
{% endblock %}
