{% extends 'admin/base.html.twig' %}

{% block title %}Commandes — Admin{% endblock %}
{% block page_title %}Commandes{% endblock %}

{% block header_actions %}
    <a href="{{ path('app_admin_order_new') }}" class="bg-neutral-900 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-neutral-700">Nouvelle commande</a>
{% endblock %}

{% block admin_content %}
<div class="space-y-6">
    <form method="get" class="bg-white border border-neutral-200 rounded-xl p-4 grid grid-cols-1 md:grid-cols-4 gap-3">
        <input name="q" value="{{ filters.q }}" placeholder="Référence / email / client" class="px-4 py-2.5 border border-neutral-200 rounded-lg text-sm">
        <select name="status" class="px-4 py-2.5 border border-neutral-200 rounded-lg text-sm">
            <option value="">Tous les statuts</option>
            {% for key, label in statusLabels %}
                <option value="{{ key }}" {% if filters.status == key %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>
        <button class="bg-neutral-900 text-white text-sm font-medium px-4 py-2.5 rounded-lg" type="submit">Filtrer</button>
        <a href="{{ path('app_admin_order_index') }}" class="text-sm text-neutral-600 self-center">Réinitialiser</a>
    </form>

    <div class="bg-white rounded-xl border border-neutral-200 overflow-hidden">
        <table class="min-w-full text-sm">
            <thead class="bg-neutral-50 text-neutral-500">
                <tr>
                    <th class="text-left px-4 py-3">Référence</th>
                    <th class="text-left px-4 py-3">Client</th>
                    <th class="text-left px-4 py-3">Statut</th>
                    <th class="text-left px-4 py-3">Total</th>
                    <th class="text-left px-4 py-3">Date</th>
                    <th class="text-right px-4 py-3">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for order in orders %}
                <tr class="border-t border-neutral-100">
                    <td class="px-4 py-3 font-medium text-neutral-900">{{ order.reference }}</td>
                    <td class="px-4 py-3 text-neutral-600">{{ order.customerName }}<br><span class="text-xs">{{ order.customerEmail }}</span></td>
                    <td class="px-4 py-3">{{ include('admin/order/_status_badge.html.twig', {status: order.status, label: statusLabels[order.status] ?? order.status}) }}</td>
                    <td class="px-4 py-3 text-neutral-600">{{ order.formattedTotal }}</td>
                    <td class="px-4 py-3 text-neutral-600">{{ order.createdAt|date('d/m/Y H:i') }}</td>
                    <td class="px-4 py-3">
                        <div class="flex justify-end items-center gap-3">
                            <a href="{{ path('app_admin_order_show', {id: order.id}) }}" class="text-neutral-600 hover:text-neutral-900">Voir</a>
                            <a href="{{ path('app_admin_order_edit', {id: order.id}) }}" class="text-amber-700 hover:text-amber-800">Modifier</a>
                            <form method="post" action="{{ path('app_admin_order_delete', {id: order.id}) }}" onsubmit="return confirm('Supprimer cette commande ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_order_' ~ order.id) }}">
                                <button class="text-red-600 hover:text-red-700" type="submit">Supprimer</button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="px-4 py-8 text-center text-neutral-500">Aucune commande.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if pages > 1 %}
        <nav class="flex items-center gap-2">
            {% for i in 1..pages %}
                <a href="{{ path('app_admin_order_index', app.request.query.all|merge({page: i})) }}"
                   class="px-3 py-1.5 rounded-lg text-sm {{ i == page ? 'bg-neutral-900 text-white' : 'bg-white border border-neutral-200 text-neutral-700' }}">{{ i }}</a>
            {% endfor %}
        </nav>
    {% endif %}
</div>
{% endblock %}
