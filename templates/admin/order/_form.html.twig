{{ form_start(form, {attr: {class: 'space-y-6'}}) }}
    <div class="grid md:grid-cols-2 gap-4">
        <div>
            {{ form_label(form.reference, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
            {{ form_widget(form.reference, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
            {{ form_errors(form.reference) }}
        </div>
        <div>
            {{ form_label(form.status, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
            {{ form_widget(form.status, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
            {{ form_errors(form.status) }}
        </div>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
        <div>
            {{ form_label(form.customerName, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
            {{ form_widget(form.customerName, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
            {{ form_errors(form.customerName) }}
        </div>
        <div>
            {{ form_label(form.customerEmail, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
            {{ form_widget(form.customerEmail, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg'}}) }}
            {{ form_errors(form.customerEmail) }}
        </div>
    </div>

    <div>
        {{ form_label(form.notes, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
        {{ form_widget(form.notes, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg min-h-20'}}) }}
        {{ form_errors(form.notes) }}
    </div>

    {% set prototype %}
        <div class="grid md:grid-cols-3 gap-3 border border-neutral-200 rounded-lg p-4 mb-3">
            <div>{{ form_row(form.items.vars.prototype.productName) }}</div>
            <div>{{ form_row(form.items.vars.prototype.unitPrice) }}</div>
            <div>
                {{ form_row(form.items.vars.prototype.quantity) }}
                <button type="button" class="mt-2 text-sm text-red-600 js-remove-item">Supprimer la ligne</button>
            </div>
        </div>
    {% endset %}

    <div>
        <div class="flex items-center justify-between mb-2">
            {{ form_label(form.items, null, {label_attr: {class: 'text-sm font-medium text-neutral-700'}}) }}
            <button type="button" id="add-order-item" class="text-sm font-semibold text-amber-700 hover:text-amber-800">+ Ajouter une ligne</button>
        </div>

        <div id="order-items"
             data-index="{{ form.items|length }}"
             data-prototype="{{ prototype|e('html_attr') }}">
            {% for itemForm in form.items %}
                <div class="grid md:grid-cols-3 gap-3 border border-neutral-200 rounded-lg p-4 mb-3">
                    <div>{{ form_row(itemForm.productName) }}</div>
                    <div>{{ form_row(itemForm.unitPrice) }}</div>
                    <div>
                        {{ form_row(itemForm.quantity) }}
                        <button type="button" class="mt-2 text-sm text-red-600 js-remove-item">Supprimer la ligne</button>
                    </div>
                </div>
            {% endfor %}
        </div>
        {{ form_errors(form.items) }}
    </div>

    <div>
        {{ form_label(form.total, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
        {{ form_widget(form.total, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg bg-neutral-50'}}) }}
    </div>

    <div class="pt-4 border-t border-neutral-200 flex items-center gap-3">
        <button class="bg-neutral-900 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-neutral-700" type="submit">Enregistrer</button>
        <a href="{{ path('app_admin_order_index') }}" class="text-sm text-neutral-600 hover:text-neutral-900">Annuler</a>
    </div>
{{ form_end(form) }}

<script>
    (function () {
        const container = document.getElementById('order-items');
        const addButton = document.getElementById('add-order-item');
        if (!container || !addButton) {
            return;
        }

        const bindRemoveButtons = () => {
            container.querySelectorAll('.js-remove-item').forEach((button) => {
                if (button.dataset.bound === '1') {
                    return;
                }
                button.dataset.bound = '1';
                button.addEventListener('click', () => {
                    const row = button.closest('.grid');
                    row?.remove();
                });
            });
        };

        bindRemoveButtons();

        addButton.addEventListener('click', () => {
            const index = Number(container.dataset.index || '0');
            const template = container.dataset.prototype || '';
            const html = template.replace(/__name__/g, String(index));
            container.insertAdjacentHTML('beforeend', html);
            container.dataset.index = String(index + 1);
            bindRemoveButtons();
        });
    })();
</script>
