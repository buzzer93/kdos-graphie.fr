{% extends 'admin/base.html.twig' %}

{% block title %}Contenu — Admin{% endblock %}
{% block page_title %}Contenu de la page d'accueil{% endblock %}

{% block admin_content %}
<div class="max-w-4xl space-y-6">

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="rounded-lg border px-4 py-3 text-sm {{ type == 'danger' ? 'border-red-200 bg-red-50 text-red-700' : (type == 'warning' ? 'border-amber-200 bg-amber-50 text-amber-700' : 'border-emerald-200 bg-emerald-50 text-emerald-700') }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {# ── Onglets ── #}
    {% set tabs = [
        { key: 'hero',        label: 'Hero' },
        { key: 'savoirfaire', label: 'Savoir-faire' },
        { key: 'produits',    label: 'Produits phares' },
        { key: 'contact',     label: 'Contact' },
    ] %}

    <div class="border-b border-neutral-200">
        <nav class="-mb-px flex gap-1">
            {% for t in tabs %}
                <a href="{{ path('app_admin_content_index', {tab: t.key}) }}"
                   class="px-5 py-3 text-sm font-medium border-b-2 transition
                          {{ tab == t.key
                              ? 'border-amber-500 text-amber-700'
                              : 'border-transparent text-neutral-500 hover:text-neutral-900 hover:border-neutral-300' }}">
                    {{ t.label }}
                </a>
            {% endfor %}
        </nav>
    </div>

    {# ══════════════ HERO ══════════════ #}
    {% if tab == 'hero' %}
    <form method="post" action="{{ path('app_admin_content_save', {section: 'hero'}) }}" class="space-y-6">
        <input type="hidden" name="_token" value="{{ csrf_token('content_save_hero') }}">

        <section class="bg-white border border-neutral-200 rounded-xl overflow-hidden">
            <div class="px-6 py-4 border-b border-neutral-100">
                <h2 class="text-sm font-semibold text-neutral-900">Badge & accroche</h2>
            </div>
            <div class="divide-y divide-neutral-100">
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Badge</label>
                    <div class="md:col-span-2">
                        <input type="text" name="content[home_hero_badge]" value="{{ values.home_hero_badge }}"
                               class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                        <p class="text-xs text-neutral-400 mt-1">Ex : "Fait main · Atelier artisanal"</p>
                    </div>
                </div>
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Titre (partie normale)</label>
                    <div class="md:col-span-2">
                        <input type="text" name="content[home_hero_title]" value="{{ values.home_hero_title }}"
                               class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                </div>
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Titre (partie en amber)</label>
                    <div class="md:col-span-2">
                        <input type="text" name="content[home_hero_title_highlight]" value="{{ values.home_hero_title_highlight }}"
                               class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                </div>
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Sous-titre</label>
                    <div class="md:col-span-2">
                        <textarea name="content[home_hero_subtitle]" rows="3"
                                  class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm resize-y">{{ values.home_hero_subtitle }}</textarea>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-white border border-neutral-200 rounded-xl overflow-hidden">
            <div class="px-6 py-4 border-b border-neutral-100">
                <h2 class="text-sm font-semibold text-neutral-900">Statistiques</h2>
            </div>
            <div class="divide-y divide-neutral-100">
                {% for n in 1..3 %}
                    <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-center">
                        <p class="text-sm font-medium text-neutral-700">Stat {{ n }}</p>
                        <div class="md:col-span-2 flex gap-3">
                            <div class="flex-1">
                                <label class="block text-xs text-neutral-500 mb-1">Valeur</label>
                                <input type="text" name="content[home_hero_stat_{{ n }}_value]"
                                       value="{{ values['home_hero_stat_' ~ n ~ '_value'] }}"
                                       class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                            </div>
                            <div class="flex-1">
                                <label class="block text-xs text-neutral-500 mb-1">Libellé</label>
                                <input type="text" name="content[home_hero_stat_{{ n }}_label]"
                                       value="{{ values['home_hero_stat_' ~ n ~ '_label'] }}"
                                       class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

        <div class="flex justify-end">
            <button type="submit" class="bg-neutral-900 text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-neutral-700">
                Enregistrer le Hero
            </button>
        </div>
    </form>
    {% endif %}

    {# ══════════════ SAVOIR-FAIRE ══════════════ #}
    {% if tab == 'savoirfaire' %}
    <form method="post" action="{{ path('app_admin_content_save', {section: 'savoirfaire'}) }}" class="space-y-6">
        <input type="hidden" name="_token" value="{{ csrf_token('content_save_savoirfaire') }}">

        <section class="bg-white border border-neutral-200 rounded-xl overflow-hidden">
            <div class="px-6 py-4 border-b border-neutral-100">
                <h2 class="text-sm font-semibold text-neutral-900">En-tête de section</h2>
            </div>
            <div class="divide-y divide-neutral-100">
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Eyebrow</label>
                    <div class="md:col-span-2">
                        <input type="text" name="content[home_sf_eyebrow]" value="{{ values.home_sf_eyebrow }}"
                               class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                </div>
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Titre</label>
                    <div class="md:col-span-2">
                        <input type="text" name="content[home_sf_title]" value="{{ values.home_sf_title }}"
                               class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                </div>
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Sous-titre</label>
                    <div class="md:col-span-2">
                        <textarea name="content[home_sf_subtitle]" rows="2"
                                  class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm resize-y">{{ values.home_sf_subtitle }}</textarea>
                    </div>
                </div>
            </div>
        </section>

        {% for n in 1..6 %}
        <section class="bg-white border border-neutral-200 rounded-xl overflow-hidden">
            <div class="px-6 py-4 border-b border-neutral-100">
                <h2 class="text-sm font-semibold text-neutral-900">Carte {{ n }}</h2>
            </div>
            <div class="divide-y divide-neutral-100">
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Icône (emoji)</label>
                    <div class="md:col-span-2">
                        <input type="text" name="content[home_sf_{{ n }}_icon]"
                               value="{{ values['home_sf_' ~ n ~ '_icon'] }}"
                               class="w-24 px-3 py-2 border border-neutral-200 rounded-lg text-sm text-center text-xl">
                    </div>
                </div>
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Titre</label>
                    <div class="md:col-span-2">
                        <input type="text" name="content[home_sf_{{ n }}_title]"
                               value="{{ values['home_sf_' ~ n ~ '_title'] }}"
                               class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                </div>
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Description</label>
                    <div class="md:col-span-2">
                        <textarea name="content[home_sf_{{ n }}_desc]" rows="2"
                                  class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm resize-y">{{ values['home_sf_' ~ n ~ '_desc'] }}</textarea>
                    </div>
                </div>
            </div>
        </section>
        {% endfor %}

        <div class="flex justify-end">
            <button type="submit" class="bg-neutral-900 text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-neutral-700">
                Enregistrer le Savoir-faire
            </button>
        </div>
    </form>
    {% endif %}

    {# ══════════════ PRODUITS PHARES ══════════════ #}
    {% if tab == 'produits' %}
    <form method="post" action="{{ path('app_admin_content_save', {section: 'produits'}) }}" class="space-y-6">
        <input type="hidden" name="_token" value="{{ csrf_token('content_save_produits') }}">

        <section class="bg-white border border-neutral-200 rounded-xl overflow-hidden">
            <div class="px-6 py-4 border-b border-neutral-100">
                <h2 class="text-sm font-semibold text-neutral-900">En-tête de section</h2>
                <p class="text-xs text-neutral-500 mt-0.5">Les produits affichés viennent du catalogue (8 derniers produits visibles).</p>
            </div>
            <div class="divide-y divide-neutral-100">
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Eyebrow</label>
                    <div class="md:col-span-2">
                        <input type="text" name="content[home_produits_eyebrow]" value="{{ values.home_produits_eyebrow }}"
                               class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                </div>
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Titre</label>
                    <div class="md:col-span-2">
                        <input type="text" name="content[home_produits_title]" value="{{ values.home_produits_title }}"
                               class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                </div>
            </div>
        </section>

        <div class="flex justify-end">
            <button type="submit" class="bg-neutral-900 text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-neutral-700">
                Enregistrer les Produits phares
            </button>
        </div>
    </form>
    {% endif %}

    {# ══════════════ CONTACT ══════════════ #}
    {% if tab == 'contact' %}
    <form method="post" action="{{ path('app_admin_content_save', {section: 'contact'}) }}" class="space-y-6">
        <input type="hidden" name="_token" value="{{ csrf_token('content_save_contact') }}">

        <section class="bg-white border border-neutral-200 rounded-xl overflow-hidden">
            <div class="px-6 py-4 border-b border-neutral-100">
                <h2 class="text-sm font-semibold text-neutral-900">Bloc CTA Contact</h2>
                <p class="text-xs text-neutral-500 mt-0.5">Le numéro de téléphone est géré dans <a href="{{ path('app_admin_settings_index') }}" class="underline hover:text-neutral-700">Paramètres → Coordonnées</a>.</p>
            </div>
            <div class="divide-y divide-neutral-100">
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Titre</label>
                    <div class="md:col-span-2">
                        <input type="text" name="content[home_contact_title]" value="{{ values.home_contact_title }}"
                               class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                </div>
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <label class="text-sm font-medium text-neutral-700 pt-2">Sous-titre</label>
                    <div class="md:col-span-2">
                        <textarea name="content[home_contact_subtitle]" rows="3"
                                  class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm resize-y">{{ values.home_contact_subtitle }}</textarea>
                    </div>
                </div>
            </div>
        </section>

        <div class="flex justify-end">
            <button type="submit" class="bg-neutral-900 text-white text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-neutral-700">
                Enregistrer le Contact
            </button>
        </div>
    </form>
    {% endif %}

</div>
{% endblock %}
