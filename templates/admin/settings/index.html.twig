{% extends 'admin/base.html.twig' %}

{% block title %}Paramètres — Admin{% endblock %}
{% block page_title %}Paramètres{% endblock %}

{% block admin_content %}
<div class="space-y-8 max-w-3xl">

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="rounded-lg border px-4 py-3 text-sm {{ type == 'danger' ? 'border-red-200 bg-red-50 text-red-700' : (type == 'warning' ? 'border-amber-200 bg-amber-50 text-amber-700' : 'border-emerald-200 bg-emerald-50 text-emerald-700') }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {# ── Coordonnées de l'atelier ── #}
    <section class="bg-white border border-neutral-200 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-neutral-100">
            <h2 class="text-sm font-semibold text-neutral-900">Coordonnées de l'atelier</h2>
            <p class="text-xs text-neutral-500 mt-0.5">Ces informations peuvent apparaître sur le site (footer, page contact).</p>
        </div>
        <form method="post" action="{{ path('app_admin_settings_index') }}" class="divide-y divide-neutral-100">
            <input type="hidden" name="_token" value="{{ csrf_token('settings_save') }}">
            {% for setting in contactSettings %}
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <div>
                        <p class="text-sm font-medium text-neutral-900">{{ setting.label }}</p>
                        <p class="text-xs text-neutral-400 mt-0.5 font-mono">{{ setting.settingKey }}</p>
                    </div>
                    <div class="md:col-span-2">
                        <input type="text"
                            name="settings[{{ setting.settingKey }}]"
                            value="{{ setting.settingValue ?? '' }}"
                            class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                        <p class="text-xs text-neutral-400 mt-1">Modifié le {{ setting.updatedAt|date('d/m/Y H:i') }}</p>
                    </div>
                </div>
            {% endfor %}
            <div class="px-6 py-4">
                <button type="submit" class="bg-neutral-900 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-neutral-700">
                    Enregistrer
                </button>
            </div>
        </form>
    </section>

    {# ── Autres paramètres ── #}
    {% if otherSettings is not empty %}
    <section class="bg-white border border-neutral-200 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-neutral-100">
            <h2 class="text-sm font-semibold text-neutral-900">Autres paramètres</h2>
        </div>
        <form method="post" action="{{ path('app_admin_settings_index') }}" class="divide-y divide-neutral-100">
            <input type="hidden" name="_token" value="{{ csrf_token('settings_save') }}">
            {% for setting in otherSettings %}
                <div class="px-6 py-4 grid md:grid-cols-3 gap-4 items-start">
                    <div>
                        <p class="text-sm font-medium text-neutral-900">{{ setting.label }}</p>
                        <p class="text-xs text-neutral-400 mt-0.5 font-mono">{{ setting.settingKey }}</p>
                    </div>
                    <div class="md:col-span-2">
                        <textarea name="settings[{{ setting.settingKey }}]" rows="2"
                            class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm resize-y"
                        >{{ setting.settingValue }}</textarea>
                        <p class="text-xs text-neutral-400 mt-1">Modifié le {{ setting.updatedAt|date('d/m/Y H:i') }}</p>
                    </div>
                </div>
            {% endfor %}
            <div class="px-6 py-4">
                <button type="submit" class="bg-neutral-900 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-neutral-700">
                    Enregistrer
                </button>
            </div>
        </form>
    </section>
    {% endif %}

    {# ── Identifiants admin ── #}
    <section class="bg-white border border-neutral-200 rounded-xl overflow-hidden">
        <div class="px-6 py-4 border-b border-neutral-100">
            <h2 class="text-sm font-semibold text-neutral-900">Identifiants administrateur</h2>
            <p class="text-xs text-neutral-500 mt-0.5">Le mot de passe actuel est requis pour toute modification.</p>
        </div>

        <div class="divide-y divide-neutral-100">
            {# Changer l'email #}
            <div class="px-6 py-5">
                <h3 class="text-sm font-medium text-neutral-700 mb-3">Changer l'adresse email</h3>
                <form method="post" action="{{ path('app_admin_settings_change_email') }}" class="space-y-3 max-w-sm" autocomplete="off">
                    <input type="hidden" name="_token" value="{{ csrf_token('settings_change_email') }}">
                    <div>
                        <label class="block text-xs font-medium text-neutral-600 mb-1">Mot de passe actuel</label>
                        <input type="password" name="current_password" required autocomplete="new-password"
                            class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-neutral-600 mb-1">Nouvelle adresse email</label>
                        <input type="email" name="new_email" required autocomplete="new-password"
                            class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                    <button type="submit" class="px-4 py-2 rounded-lg bg-neutral-800 text-white text-sm font-medium hover:bg-neutral-700">
                        Modifier l'email
                    </button>
                </form>
            </div>

            {# Changer le mot de passe #}
            <div class="px-6 py-5">
                <h3 class="text-sm font-medium text-neutral-700 mb-3">Changer le mot de passe</h3>
                <form method="post" action="{{ path('app_admin_settings_change_password') }}" class="space-y-3 max-w-sm" autocomplete="off">
                    <input type="hidden" name="_token" value="{{ csrf_token('settings_change_password') }}">
                    <div>
                        <label class="block text-xs font-medium text-neutral-600 mb-1">Mot de passe actuel</label>
                        <input type="password" name="current_password" required autocomplete="new-password"
                            class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-neutral-600 mb-1">Nouveau mot de passe (8 car. min.)</label>
                        <input type="password" name="new_password" required minlength="8" autocomplete="new-password"
                            class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-neutral-600 mb-1">Confirmer le nouveau mot de passe</label>
                        <input type="password" name="confirm_password" required autocomplete="new-password"
                            class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                    <button type="submit" class="px-4 py-2 rounded-lg bg-neutral-800 text-white text-sm font-medium hover:bg-neutral-700">
                        Modifier le mot de passe
                    </button>
                </form>
            </div>
        </div>
    </section>

</div>
{% endblock %}
