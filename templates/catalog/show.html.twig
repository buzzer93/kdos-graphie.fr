{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} — Kdos Graphie{% endblock %}

{% block body %}
<div class="min-h-screen bg-white text-neutral-800">

    {# ===== HEADER ===== #}
    {{ include('partials/_header_public.html.twig') }}

    {# ===== FLASH MESSAGES ===== #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-4 js-auto-dismiss-flash">
                {% if type == 'cart_added' %}
                    <div class="flex items-center justify-between gap-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm transition-opacity duration-300">
                        <div class="flex items-center gap-2 text-emerald-800">
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
                            </svg>
                            <span><strong>{{ message }}</strong> ajouté à votre demande.</span>
                        </div>
                        <div class="flex items-center gap-3 shrink-0">
                            <a href="{{ path('app_cart_index') }}"
                               class="bg-neutral-900 hover:bg-amber-600 text-white text-xs font-semibold px-4 py-2 rounded-lg transition whitespace-nowrap">
                                Voir ma demande →
                            </a>
                        </div>
                    </div>
                {% else %}
                    <div class="rounded-lg border px-4 py-3 text-sm transition-opacity duration-300
                        {{ type == 'danger' ? 'border-red-200 bg-red-50 text-red-700'
                        : (type == 'warning' ? 'border-amber-200 bg-amber-50 text-amber-700'
                        : 'border-emerald-200 bg-emerald-50 text-emerald-700') }}">
                        {{ message }}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    {% endfor %}

    {# ===== HERO PRODUIT ===== #}
    <main class="max-w-6xl mx-auto px-6 py-10">
        <div class="grid lg:grid-cols-2 gap-10 items-start">

            {# Image #}
            <div class="bg-neutral-100 rounded-2xl overflow-hidden min-h-[380px] flex items-center justify-center">
                {% if imagePublicPath %}
                    <img
                        src="{{ asset(imagePublicPath) }}"
                        alt="{{ product.name }}"
                        class="w-full h-full object-cover"
                    >
                {% else %}
                    <div class="flex flex-col items-center gap-4 py-16 px-8 text-center">
                        <img src="{{ asset('media/LOGO Kdos-graphie.png') }}" alt="Kdos Graphie" class="h-20 w-auto opacity-20">
                        <p class="text-sm text-neutral-400">Image à venir</p>
                    </div>
                {% endif %}
            </div>

            {# Infos produit #}
            <div class="space-y-6">
                {% if product.category %}
                    <p class="text-xs uppercase tracking-[0.2em] text-amber-600 font-semibold">{{ product.category.name }}</p>
                {% endif %}

                <h1 class="font-display text-4xl font-bold text-neutral-900 leading-tight">{{ product.name }}</h1>

                {% if optionGroupsJson is not empty %}
                    <p class="text-3xl font-bold text-amber-600">
                        À partir de {{ (product.price / 100)|number_format(2, ',', ' ') }} €
                    </p>
                {% else %}
                    <p class="text-3xl font-bold text-amber-600">
                        {{ (product.price / 100)|number_format(2, ',', ' ') }} €
                    </p>
                {% endif %}

                {% if product.description %}
                    <p class="text-neutral-600 leading-relaxed whitespace-pre-line">{{ product.description }}</p>
                {% endif %}

                {# Séparateur #}
                <div class="border-t border-neutral-200 pt-6 space-y-4">

                    <form
                        method="post"
                        action="{{ path('app_cart_add', {id: product.id}) }}"
                        enctype="multipart/form-data"
                        class="space-y-5"
                        {% if optionGroupsJson is not empty %}
                            data-controller="product-option"
                            data-product-option-base-price-value="{{ product.price }}"
                            data-product-option-groups-value="{{ optionGroupsJson|json_encode }}"
                        {% endif %}
                    >
                        <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                        <input type="hidden" name="product_slug" value="{{ product.slug }}">

                        {# ===== SÉLECTEURS D'OPTIONS ===== #}
                        {% if optionGroupsJson is not empty %}
                            {% for group in optionGroupsJson %}
                                <div>
                                    <label for="option_group_{{ group.id }}" class="block text-sm font-medium text-neutral-700 mb-1.5">
                                        {{ group.name }}
                                    </label>
                                    <select
                                        id="option_group_{{ group.id }}"
                                        data-option-group="{{ group.id }}"
                                        data-action="change->product-option#onChange"
                                        class="w-full px-3 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 bg-white"
                                    >
                                        <option value="">— Choisir {{ group.name|lower }} —</option>
                                        {% for value in group.values %}
                                            <option value="{{ value.id }}">
                                                {{ value.label }}{% if value.priceAdjustment > 0 %} (+{{ (value.priceAdjustment / 100)|number_format(2, ',', ' ') }} €){% endif %}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endfor %}

                            {# Conteneur pour les hidden inputs injectés par Stimulus #}
                            <div data-product-option-target="hiddenInputs"></div>

                            {# Prix dynamique #}
                            <p class="text-2xl font-bold text-amber-600">
                                <span data-product-option-target="price">{{ (product.price / 100)|number_format(2, ',', ' ') }} €</span>
                            </p>
                        {% endif %}

                        <div>
                            <label for="quantity" class="block text-sm font-medium text-neutral-700 mb-1.5">Quantité</label>
                            <input
                                id="quantity"
                                type="number"
                                name="quantity"
                                min="1"
                                value="1"
                                class="w-28 px-3 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
                            >
                        </div>

                        <div>
                            <label for="customization_text" class="block text-sm font-medium text-neutral-700 mb-1.5">Texte à graver <span class="text-neutral-400 font-normal">(optionnel)</span></label>
                            <textarea
                                id="customization_text"
                                name="customization_text"
                                rows="3"
                                class="w-full px-3 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
                                placeholder="Ex : Joyeux anniversaire Marie, le 12 juin 2025"
                            ></textarea>
                        </div>

                        <div>
                            <label for="customization_file" class="block text-sm font-medium text-neutral-700 mb-1.5">Image ou fichier à graver <span class="text-neutral-400 font-normal">(optionnel)</span></label>
                            <input
                                id="customization_file"
                                type="file"
                                name="customization_file"
                                accept=".png,.jpg,.jpeg,.webp,.pdf"
                                class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm text-neutral-600"
                            >
                            <p class="mt-1.5 text-xs text-neutral-400">Formats acceptés : PNG, JPG, WEBP, PDF — 15 Mo max. L'ajout d'un fichier génère une demande de devis.</p>
                        </div>

                        <div>
                            <label for="special_request" class="block text-sm font-medium text-neutral-700 mb-1.5">Demande particulière <span class="text-neutral-400 font-normal">(optionnel)</span></label>
                            <textarea
                                id="special_request"
                                name="special_request"
                                rows="3"
                                class="w-full px-3 py-2.5 border border-neutral-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
                                placeholder="Option non listée, format sur mesure, précision sur la gravure…"
                            ></textarea>
                            <p class="mt-1.5 text-xs text-neutral-400">Une demande particulière génère une demande de devis sur mesure.</p>
                        </div>

                        <button
                            type="submit"
                            {% if optionGroupsJson is not empty %}data-product-option-target="submit" disabled{% endif %}
                            class="w-full bg-neutral-900 hover:bg-amber-600 disabled:bg-neutral-300 disabled:cursor-not-allowed text-white font-semibold px-6 py-3.5 rounded-xl transition duration-200 text-sm"
                        >
                            Ajouter à ma demande
                        </button>
                    </form>
                </div>

                {# Infos atelier #}
                <div class="flex flex-wrap gap-2 pt-1">
                    <span class="inline-flex items-center gap-1.5 text-xs text-neutral-600 bg-neutral-100 rounded-full px-3 py-1.5">
                        <span class="text-amber-500">✦</span>
                        <span>Commande validée manuellement</span>
                    </span>
                    <span class="inline-flex items-center gap-1.5 text-xs text-neutral-600 bg-neutral-100 rounded-full px-3 py-1.5">
                        <span class="text-amber-500">✦</span>
                        <span>Délai indicatif : 48h</span>
                    </span>
                </div>
            </div>
        </div>
    </main>

    {# ===== CTA RETOUR ===== #}
    <section class="py-16 bg-amber-50 border-t border-amber-100 mt-10">
        <div class="max-w-3xl mx-auto px-6 text-center">
            <h2 class="font-display text-2xl font-bold text-neutral-900">D'autres créations vous attendent</h2>
            <p class="text-neutral-600 mt-3">Parcourez l'ensemble de notre catalogue pour trouver le cadeau parfait.</p>
            <a href="{{ path('app_catalog_index') }}" class="mt-6 inline-block bg-neutral-900 hover:bg-amber-600 text-white font-semibold px-8 py-3.5 rounded-full transition duration-200">
                Voir tout le catalogue
            </a>
        </div>
    </section>

    {# ===== FOOTER ===== #}
    <footer class="bg-neutral-100 text-neutral-600 py-10 border-t border-neutral-200">
        <div class="max-w-7xl mx-auto px-6 flex flex-wrap items-center justify-between gap-4 text-sm">
            <div class="flex items-center gap-3">
                <img src="{{ asset('media/LOGO Kdos-graphie.png') }}" alt="Kdos Graphie" class="h-8 w-auto">
                <span class="font-display text-neutral-900">Kdos Graphie</span>
            </div>
            <p>© {{ "now"|date("Y") }} Kdos Graphie — Artisan graveur laser.</p>
            <a href="{{ path('app_contact') }}" class="hover:text-amber-600 transition">Contact</a>
        </div>
    </footer>
</div>

<script>
    (function () {
        const flashes = document.querySelectorAll('.js-auto-dismiss-flash');
        if (flashes.length === 0) {
            return;
        }

        flashes.forEach((flashWrapper) => {
            window.setTimeout(() => {
                flashWrapper.classList.add('opacity-0');
                window.setTimeout(() => flashWrapper.remove(), 300);
            }, 5000);
        });
    })();
</script>
{% endblock %}
