{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} — Catalogue{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50 text-neutral-800">
    <header class="bg-white border-b border-neutral-200">
        <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
            <a href="{{ path('app_catalog_index') }}" class="text-sm text-neutral-600 hover:text-neutral-900">← Retour au catalogue</a>
            <a href="{{ path('app_cart_index') }}" class="text-sm font-semibold text-neutral-700 hover:text-amber-700">Voir le panier</a>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-10">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-4 rounded-lg border px-4 py-3 text-sm {{ type == 'danger' ? 'border-red-200 bg-red-50 text-red-700' : (type == 'warning' ? 'border-amber-200 bg-amber-50 text-amber-700' : 'border-emerald-200 bg-emerald-50 text-emerald-700') }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <div class="bg-white border border-neutral-200 rounded-2xl overflow-hidden grid lg:grid-cols-2">
            <div class="bg-neutral-100 min-h-[320px] flex items-center justify-center">
                {% if imagePublicPath %}
                    <img src="{{ asset(imagePublicPath) }}" alt="{{ product.name }}" class="w-full h-full object-cover">
                {% else %}
                    <span class="text-neutral-500">Aucune image</span>
                {% endif %}
            </div>
            <div class="p-8 space-y-4">
                <p class="text-xs uppercase tracking-wider text-neutral-500">{{ product.category ? product.category.name : 'Sans catégorie' }}</p>
                <h1 class="font-display text-4xl text-neutral-900">{{ product.name }}</h1>
                <p class="text-amber-700 text-xl font-semibold">{{ (product.price / 100)|number_format(2, ',', ' ') }} €</p>
                <p class="text-neutral-700 whitespace-pre-line">{{ product.description ?: 'Description à venir.' }}</p>
                <p class="text-sm text-neutral-500">Stock disponible: {{ product.stock }}</p>

                <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}" enctype="multipart/form-data" class="pt-4 border-t border-neutral-200 space-y-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                    <input type="hidden" name="product_slug" value="{{ product.slug }}">

                    <div>
                        <label class="block text-sm font-medium text-neutral-700 mb-1">Quantite</label>
                        <input type="number" name="quantity" min="1" value="1" class="w-28 px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-neutral-700 mb-1">Texte personnalise</label>
                        <textarea name="customization_text" rows="3" class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm" placeholder="Votre texte (optionnel)"></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-neutral-700 mb-1">Fichier personnalisation</label>
                        <input type="file" name="customization_file" accept=".png,.jpg,.jpeg,.webp,.pdf" class="w-full px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                        <p class="mt-1 text-xs text-neutral-500">Formats autorises: png, jpg, jpeg, webp, pdf. Taille max: 15 Mo.</p>
                    </div>

                    <button type="submit" class="bg-neutral-900 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-neutral-700">Ajouter au panier</button>
                </form>
            </div>
        </div>
    </main>
</div>
{% endblock %}
