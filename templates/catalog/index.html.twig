{% extends 'base.html.twig' %}

{% block title %}Catalogue — Kdos Graphie{% endblock %}

{% block body %}
<div class="min-h-screen bg-white text-neutral-800">

    {# ===== HEADER ===== #}
    <header class="bg-white border-b border-neutral-200">
        <div class="max-w-7xl mx-auto px-6 py-6 flex items-center justify-between gap-4">
            <a href="{{ path('app_home') }}" class="flex items-center gap-3">
                <img src="{{ asset('media/LOGO Kdos-graphie.svg') }}" alt="Kdos Graphie" class="h-10 w-auto">
                <span class="font-display text-xl text-neutral-900">Kdos Graphie</span>
            </a>
            <div class="flex items-center gap-5">
                <a href="{{ path('app_contact') }}" class="text-sm text-neutral-600 hover:text-amber-700 transition">Contact</a>
                <a href="{{ path('app_cart_index') }}" class="text-sm text-neutral-600 hover:text-amber-700 transition">Panier</a>
                <a href="{{ path('app_login') }}" class="text-sm text-neutral-600 hover:text-amber-700 transition">Admin</a>
            </div>
        </div>
    </header>

    {# ===== HERO ===== #}
    <div class="bg-neutral-50 border-b border-neutral-100 py-10 px-6">
        <div class="max-w-7xl mx-auto">
            <p class="uppercase tracking-[0.25em] text-amber-600 text-xs font-semibold">Nos créations</p>
            <h1 class="font-display text-4xl md:text-5xl font-bold text-neutral-900 mt-2">Catalogue</h1>
            <p class="text-neutral-600 mt-3">Découvrez nos produits personnalisables, gravés à la main dans notre atelier.</p>
        </div>
    </div>

    {# ===== CAROUSELS PAR CATÉGORIE ===== #}
    <main>
        {% set hasProducts = false %}

        {% for category in categories %}
            {% set catProducts = productsByCategory[category.id] ?? [] %}
            {% if catProducts is not empty %}
                {% set hasProducts = true %}
                {% set carouselId = 'carousel-cat-' ~ category.id %}

                <section class="py-16 {{ loop.index is even ? 'bg-neutral-50' : 'bg-white' }} border-b border-neutral-100">
                    <div class="max-w-7xl mx-auto px-6">

                        <div class="flex items-end justify-between gap-4 mb-8">
                            <h2 class="font-display text-2xl md:text-3xl font-bold text-neutral-900">
                                {{ category.name }}
                            </h2>
                            <div class="flex gap-2 shrink-0">
                                <button
                                    onclick="scrollCarousel('{{ carouselId }}', -1)"
                                    aria-label="Précédent"
                                    class="w-10 h-10 rounded-full border border-neutral-300 text-neutral-700 hover:border-amber-500 hover:bg-amber-500 hover:text-white transition flex items-center justify-center text-sm"
                                >←</button>
                                <button
                                    onclick="scrollCarousel('{{ carouselId }}', 1)"
                                    aria-label="Suivant"
                                    class="w-10 h-10 rounded-full border border-neutral-300 text-neutral-700 hover:border-amber-500 hover:bg-amber-500 hover:text-white transition flex items-center justify-center text-sm"
                                >→</button>
                            </div>
                        </div>

                        <div
                            id="{{ carouselId }}"
                            class="flex gap-5 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-3 -mx-6 px-6 [&::-webkit-scrollbar]:hidden"
                            style="scrollbar-width:none;"
                        >
                            {% for product in catProducts %}
                                <article class="snap-start flex-shrink-0 w-64 sm:w-72 bg-white rounded-2xl overflow-hidden border border-neutral-200 group hover:border-amber-400 hover:shadow-2xl hover:shadow-amber-500/10 hover:-translate-y-1 transition-all duration-300">
                                    <a href="{{ path('app_catalog_show', {slug: product.slug}) }}" class="block">
                                        <div class="relative h-56 overflow-hidden bg-neutral-100">
                                            {% if product.coverImage %}
                                                <img
                                                    src="{{ asset('media/products/' ~ product.coverImage) }}"
                                                    alt="{{ product.name }}"
                                                    class="w-full h-full object-cover group-hover:scale-110 transition duration-700"
                                                    loading="lazy"
                                                >
                                            {% else %}
                                                <div class="w-full h-full flex items-center justify-center">
                                                    <img src="{{ asset('media/LOGO Kdos-graphie.svg') }}" alt="Kdos Graphie" class="h-16 w-auto opacity-20">
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="p-5">
                                            <h3 class="font-display text-lg font-semibold text-neutral-900 truncate">{{ product.name }}</h3>
                                            {% if product.description %}
                                                <p class="text-sm text-neutral-500 mt-1 line-clamp-2">{{ product.description }}</p>
                                            {% endif %}
                                            <div class="flex items-center justify-between mt-4">
                                                <span class="text-amber-600 font-bold">{{ (product.price / 100)|number_format(2, ',', ' ') }} €</span>
                                                <span class="text-xs font-semibold text-neutral-500 group-hover:text-amber-600 transition">Voir →</span>
                                            </div>
                                        </div>
                                    </a>
                                </article>
                            {% endfor %}
                        </div>

                    </div>
                </section>
            {% endif %}
        {% endfor %}

        {# Produits sans catégorie #}
        {% set uncategorized = productsByCategory[0] ?? [] %}
        {% if uncategorized is not empty %}
            {% set hasProducts = true %}
            {% set carouselId = 'carousel-cat-0' %}
            <section class="py-16 bg-white border-b border-neutral-100">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="flex items-end justify-between gap-4 mb-8">
                        <h2 class="font-display text-2xl md:text-3xl font-bold text-neutral-900">Autres créations</h2>
                        <div class="flex gap-2 shrink-0">
                            <button onclick="scrollCarousel('{{ carouselId }}', -1)" aria-label="Précédent" class="w-10 h-10 rounded-full border border-neutral-300 text-neutral-700 hover:border-amber-500 hover:bg-amber-500 hover:text-white transition flex items-center justify-center text-sm">←</button>
                            <button onclick="scrollCarousel('{{ carouselId }}', 1)" aria-label="Suivant" class="w-10 h-10 rounded-full border border-neutral-300 text-neutral-700 hover:border-amber-500 hover:bg-amber-500 hover:text-white transition flex items-center justify-center text-sm">→</button>
                        </div>
                    </div>
                    <div id="{{ carouselId }}" class="flex gap-5 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-3 -mx-6 px-6 [&::-webkit-scrollbar]:hidden" style="scrollbar-width:none;">
                        {% for product in uncategorized %}
                            <article class="snap-start flex-shrink-0 w-64 sm:w-72 bg-white rounded-2xl overflow-hidden border border-neutral-200 group hover:border-amber-400 hover:shadow-2xl hover:shadow-amber-500/10 hover:-translate-y-1 transition-all duration-300">
                                <a href="{{ path('app_catalog_show', {slug: product.slug}) }}" class="block">
                                    <div class="relative h-56 overflow-hidden bg-neutral-100">
                                        {% if product.coverImage %}
                                            <img src="{{ asset('media/products/' ~ product.coverImage) }}" alt="{{ product.name }}" class="w-full h-full object-cover group-hover:scale-110 transition duration-700" loading="lazy">
                                        {% else %}
                                            <div class="w-full h-full flex items-center justify-center">
                                                <img src="{{ asset('media/LOGO Kdos-graphie.svg') }}" alt="Kdos Graphie" class="h-16 w-auto opacity-20">
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="p-5">
                                        <h3 class="font-display text-lg font-semibold text-neutral-900 truncate">{{ product.name }}</h3>
                                        {% if product.description %}
                                            <p class="text-sm text-neutral-500 mt-1 line-clamp-2">{{ product.description }}</p>
                                        {% endif %}
                                        <div class="flex items-center justify-between mt-4">
                                            <span class="text-amber-600 font-bold">{{ (product.price / 100)|number_format(2, ',', ' ') }} €</span>
                                            <span class="text-xs font-semibold text-neutral-500 group-hover:text-amber-600 transition">Voir →</span>
                                        </div>
                                    </div>
                                </a>
                            </article>
                        {% endfor %}
                    </div>
                </div>
            </section>
        {% endif %}

        {% if not hasProducts %}
            <div class="py-24 text-center text-neutral-500">
                <p class="text-lg">Aucun produit disponible pour le moment.</p>
                <a href="{{ path('app_home') }}" class="mt-6 inline-block text-sm font-semibold text-amber-600 hover:text-amber-700">← Retour à l'accueil</a>
            </div>
        {% endif %}
    </main>

    {# ===== FOOTER ===== #}
    <footer class="bg-neutral-100 text-neutral-600 py-10 border-t border-neutral-200">
        <div class="max-w-7xl mx-auto px-6 flex flex-wrap items-center justify-between gap-4 text-sm">
            <div class="flex items-center gap-3">
                <img src="{{ asset('media/LOGO Kdos-graphie.svg') }}" alt="Kdos Graphie" class="h-8 w-auto">
                <span class="font-display text-neutral-900">Kdos Graphie</span>
            </div>
            <p>© {{ "now"|date("Y") }} Kdos Graphie — Artisan graveur laser.</p>
            <a href="{{ path('app_contact') }}" class="hover:text-amber-600 transition">Contact</a>
        </div>
    </footer>
</div>

<script>
    function scrollCarousel(id, dir) {
        const el = document.getElementById(id);
        if (!el) return;
        el.scrollBy({ left: dir * Math.min(el.clientWidth * 0.8, 300), behavior: 'smooth' });
    }
</script>
{% endblock %}
