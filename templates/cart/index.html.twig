{% extends 'base.html.twig' %}

{% block title %}Panier — Kdos Graphie{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50 text-neutral-800">
    {{ include('partials/_header_public.html.twig') }}

    <main class="max-w-7xl mx-auto px-6 py-10 space-y-6">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="rounded-lg border px-4 py-3 text-sm {{ type == 'danger' ? 'border-red-200 bg-red-50 text-red-700' : (type == 'warning' ? 'border-amber-200 bg-amber-50 text-amber-700' : 'border-emerald-200 bg-emerald-50 text-emerald-700') }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <h1 class="font-display text-4xl text-neutral-900">Panier</h1>

        {% if lines is empty %}
            <div class="bg-white border border-neutral-200 rounded-xl p-8 text-center text-neutral-600">
                Votre panier est vide.
            </div>
        {% else %}
            <div class="space-y-4">
                {% for line in lines %}
                    <article class="bg-white border border-neutral-200 rounded-xl p-4 grid lg:grid-cols-[1fr_auto] gap-4">
                        <div class="space-y-1">
                            <h2 class="font-semibold text-neutral-900">{{ line.productName }}</h2>
                            <p class="text-sm text-neutral-600">Prix unitaire: {{ (line.unitPrice / 100)|number_format(2, ',', ' ') }} €</p>
                            {% if line.customizationText %}
                                <p class="text-sm text-neutral-700 whitespace-pre-line"><span class="font-medium">Texte perso:</span> {{ line.customizationText }}</p>
                            {% endif %}
                            {% if line.customizationFilePath %}
                                {% set customizationUrl = asset(fileStorage.getPublicPath(line.customizationFilePath)) %}
                                {% set customizationExtension = line.customizationFilePath|split('.')|last|lower %}
                                {% set isCustomizationImage = customizationExtension in ['png', 'jpg', 'jpeg', 'webp'] %}
                                <div class="pt-2">
                                    <p class="text-sm font-medium text-neutral-700 mb-2">Fichier perso:</p>

                                    {% if isCustomizationImage %}
                                        <button
                                            type="button"
                                            class="group relative inline-flex rounded-xl overflow-hidden border border-neutral-200 hover:border-amber-400 transition"
                                            data-preview-open
                                            data-preview-src="{{ customizationUrl }}"
                                            data-preview-alt="Aperçu de {{ line.productName }}"
                                        >
                                            <img
                                                src="{{ customizationUrl }}"
                                                alt="Miniature du fichier de personnalisation"
                                                class="w-28 h-28 object-cover"
                                                loading="lazy"
                                            >
                                            <span class="absolute inset-0 bg-neutral-900/0 group-hover:bg-neutral-900/30 transition flex items-center justify-center text-white text-xs font-semibold opacity-0 group-hover:opacity-100">
                                                Agrandir
                                            </span>
                                        </button>
                                    {% else %}
                                        <a
                                            href="{{ customizationUrl }}"
                                            target="_blank"
                                            rel="noopener"
                                            class="inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-neutral-200 text-sm text-neutral-700 hover:border-amber-400 hover:text-amber-700 transition"
                                        >
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5A3.375 3.375 0 0 0 10.125 2.25H6.75A2.25 2.25 0 0 0 4.5 4.5v15A2.25 2.25 0 0 0 6.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25V14.25Z"/>
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 2.25v4.875c0 .621.504 1.125 1.125 1.125H19.5"/>
                                            </svg>
                                            Ouvrir le fichier
                                        </a>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                        <div class="space-y-3 min-w-52">
                            <form method="post" action="{{ path('app_cart_update_quantity', {lineId: line.id}) }}" class="flex items-center gap-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_update_' ~ line.id) }}">
                                <input type="number" name="quantity" min="1" value="{{ line.quantity }}" class="w-20 px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                                <button type="submit" class="px-3 py-2 text-sm rounded-lg bg-neutral-900 text-white hover:bg-neutral-700">MAJ</button>
                            </form>
                            <p class="text-sm text-neutral-700 font-medium">Sous-total: {{ ((line.unitPrice * line.quantity) / 100)|number_format(2, ',', ' ') }} €</p>
                            <form method="post" action="{{ path('app_cart_remove', {lineId: line.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ line.id) }}">
                                <button
                                    type="submit"
                                    class="inline-flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-lg border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 hover:border-red-300 transition"
                                >
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
                                    </svg>
                                    Supprimer
                                </button>
                            </form>
                        </div>
                    </article>
                {% endfor %}
            </div>

            <div class="bg-white border border-neutral-200 rounded-xl p-6 flex items-center justify-between">
                <p class="text-neutral-700">Articles: <span class="font-semibold">{{ itemsCount }}</span></p>
                <p class="text-xl font-semibold text-neutral-900">Total: {{ (totalCents / 100)|number_format(2, ',', ' ') }} €</p>
            </div>

            <div id="customization-preview-modal" class="hidden fixed inset-0 z-50 bg-neutral-900/70 p-4 items-center justify-center">
                <button type="button" data-preview-close class="absolute inset-0" aria-label="Fermer l'aperçu"></button>
                <div class="relative z-10 max-w-4xl w-full">
                    <button
                        type="button"
                        data-preview-close
                        class="absolute -top-11 right-0 w-9 h-9 rounded-full bg-white/90 text-neutral-700 hover:text-neutral-900 flex items-center justify-center"
                        aria-label="Fermer"
                    >
                        ✕
                    </button>
                    <img id="customization-preview-image" src="" alt="" class="w-full max-h-[85vh] object-contain rounded-xl bg-white">
                </div>
            </div>
        {% endif %}
    </main>
</div>

<script>
    (function () {
        const modal = document.getElementById('customization-preview-modal');
        if (!modal) {
            return;
        }

        const previewImage = document.getElementById('customization-preview-image');
        if (!previewImage) {
            return;
        }

        const openButtons = document.querySelectorAll('[data-preview-open]');
        const closeButtons = modal.querySelectorAll('[data-preview-close]');

        const openModal = (src, alt) => {
            previewImage.src = src;
            previewImage.alt = alt || 'Aperçu du fichier de personnalisation';
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.classList.add('overflow-hidden');
        };

        const closeModal = () => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            previewImage.src = '';
            previewImage.alt = '';
            document.body.classList.remove('overflow-hidden');
        };

        openButtons.forEach((button) => {
            button.addEventListener('click', () => {
                openModal(button.dataset.previewSrc || '', button.dataset.previewAlt || '');
            });
        });

        closeButtons.forEach((button) => {
            button.addEventListener('click', closeModal);
        });

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
                closeModal();
            }
        });
    })();
</script>
{% endblock %}
