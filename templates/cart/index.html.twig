{% extends 'base.html.twig' %}

{% block title %}Panier — Kdos Graphie{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50 text-neutral-800">
    {{ include('partials/_header_public.html.twig') }}

    <main class="max-w-7xl mx-auto px-6 py-10 space-y-6">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="rounded-lg border px-4 py-3 text-sm {{ type == 'danger' ? 'border-red-200 bg-red-50 text-red-700' : (type == 'warning' ? 'border-amber-200 bg-amber-50 text-amber-700' : 'border-emerald-200 bg-emerald-50 text-emerald-700') }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <h1 class="font-display text-4xl text-neutral-900">Panier</h1>

        {% if lines is empty %}
            <div class="bg-white border border-neutral-200 rounded-xl p-8 text-center text-neutral-600">
                Votre panier est vide.
            </div>
        {% else %}
            <div class="space-y-4">
                {% for line in lines %}
                    <article class="bg-white border border-neutral-200 rounded-xl p-4 grid lg:grid-cols-[1fr_auto] gap-4">
                        <div class="space-y-1">
                            <h2 class="font-semibold text-neutral-900">{{ line.productName }}</h2>
                            <p class="text-sm text-neutral-600">Prix unitaire: {{ (line.unitPrice / 100)|number_format(2, ',', ' ') }} €</p>
                            {% if line.customizationText %}
                                <p class="text-sm text-neutral-700 whitespace-pre-line"><span class="font-medium">Texte perso:</span> {{ line.customizationText }}</p>
                            {% endif %}
                            {% if line.customizationFilePath %}
                                <p class="text-sm text-neutral-700">
                                    <span class="font-medium">Fichier perso:</span>
                                    <a href="{{ asset(fileStorage.getPublicPath(line.customizationFilePath)) }}" target="_blank" class="text-blue-700 hover:underline">Voir le fichier</a>
                                </p>
                            {% endif %}
                        </div>
                        <div class="space-y-3 min-w-52">
                            <form method="post" action="{{ path('app_cart_update_quantity', {lineId: line.id}) }}" class="flex items-center gap-2">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_update_' ~ line.id) }}">
                                <input type="number" name="quantity" min="1" value="{{ line.quantity }}" class="w-20 px-3 py-2 border border-neutral-200 rounded-lg text-sm">
                                <button type="submit" class="px-3 py-2 text-sm rounded-lg bg-neutral-900 text-white hover:bg-neutral-700">MAJ</button>
                            </form>
                            <p class="text-sm text-neutral-700 font-medium">Sous-total: {{ ((line.unitPrice * line.quantity) / 100)|number_format(2, ',', ' ') }} €</p>
                            <form method="post" action="{{ path('app_cart_remove', {lineId: line.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ line.id) }}">
                                <button type="submit" class="text-sm text-red-600 hover:text-red-700">Supprimer</button>
                            </form>
                        </div>
                    </article>
                {% endfor %}
            </div>

            <div class="bg-white border border-neutral-200 rounded-xl p-6 flex items-center justify-between">
                <p class="text-neutral-700">Articles: <span class="font-semibold">{{ itemsCount }}</span></p>
                <p class="text-xl font-semibold text-neutral-900">Total: {{ (totalCents / 100)|number_format(2, ',', ' ') }} €</p>
            </div>
        {% endif %}
    </main>
</div>
{% endblock %}
