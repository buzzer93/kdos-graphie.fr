{% set count = cart_count() %}
{% set currentRoute = app.request.attributes.get('_route') %}
{% set isHome = currentRoute == 'app_home' %}
{% set homePath = path('app_home') %}
{% set homeHref = isHome ? '#top' : homePath %}
{% set servicesHref = isHome ? '#services' : homePath ~ '#services' %}

<header
    data-site-header
    class="{{ isHome ? 'fixed top-0 inset-x-0 z-30 bg-white/90 backdrop-blur border-b border-neutral-200' : 'sticky top-0 z-20 bg-white border-b border-neutral-200' }}"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
        <a href="{{ path('app_home') }}" class="flex items-center gap-2 shrink-0 text-neutral-900">
            <img src="{{ asset('media/LOGO Kdos-graphie.png') }}" alt="Kdos Graphie" class="h-9 w-auto">
            <span class="font-display text-lg tracking-wide hidden lg:inline">Kdos Graphie</span>
        </a>

        <nav class="hidden md:flex items-center gap-7 text-sm font-medium" aria-label="Navigation principale">
                <a href="{{ homeHref }}"
                    class="transition {{ currentRoute == 'app_home' ? 'text-amber-600' : 'text-neutral-700 hover:text-amber-600' }} {{ isHome ? 'js-smooth-scroll' : '' }}">
                Accueil
            </a>
            <a href="{{ servicesHref }}"
                    class="transition text-neutral-700 hover:text-amber-600 {{ isHome ? 'js-smooth-scroll' : '' }}">
                Services
            </a>
            <a href="{{ path('app_catalog_index') }}"
               class="transition {{ currentRoute starts with 'app_catalog' ? 'text-amber-600' : 'text-neutral-700 hover:text-amber-600' }}">
                Produits
            </a>
            <a href="{{ path('app_contact') }}"
               class="transition {{ currentRoute == 'app_contact' ? 'text-amber-600' : 'text-neutral-700 hover:text-amber-600' }}">
                Contact
            </a>

            <a href="{{ path('app_cart_index') }}"
               class="relative inline-flex items-center justify-center w-10 h-10 rounded-full border transition {{ currentRoute starts with 'app_cart' or currentRoute starts with 'app_checkout' ? 'border-amber-500 text-amber-600 bg-amber-50' : 'border-neutral-300 text-neutral-700 hover:border-amber-500 hover:text-amber-600' }}"
               aria-label="Voir le panier">
                <span class="sr-only">Panier</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.962-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/>
                </svg>
                {% if count > 0 %}
                    <span class="absolute -top-1 -right-1
                                 min-w-[1.25rem] h-5 px-1 rounded-full
                                 bg-amber-500 text-white text-xs font-bold
                                 flex items-center justify-center leading-none">
                        {{ count }}
                    </span>
                {% endif %}
            </a>
        </nav>
    </div>

    <nav class="md:hidden border-t border-neutral-200 bg-white/95" aria-label="Navigation principale mobile">
        <div class="max-w-7xl mx-auto px-3 py-2 grid grid-cols-5 gap-1 text-xs">
            <a href="{{ homeHref }}" class="rounded-lg px-2 py-2 text-center {{ currentRoute == 'app_home' ? 'bg-amber-50 text-amber-700 font-semibold' : 'text-neutral-700' }} {{ isHome ? 'js-smooth-scroll' : '' }}">Accueil</a>
            <a href="{{ servicesHref }}" class="rounded-lg px-2 py-2 text-center text-neutral-700 {{ isHome ? 'js-smooth-scroll' : '' }}">Services</a>
            <a href="{{ path('app_catalog_index') }}" class="rounded-lg px-2 py-2 text-center {{ currentRoute starts with 'app_catalog' ? 'bg-amber-50 text-amber-700 font-semibold' : 'text-neutral-700' }}">Produits</a>
            <a href="{{ path('app_contact') }}" class="rounded-lg px-2 py-2 text-center {{ currentRoute == 'app_contact' ? 'bg-amber-50 text-amber-700 font-semibold' : 'text-neutral-700' }}">Contact</a>
            <a href="{{ path('app_cart_index') }}"
               class="relative inline-flex items-center justify-center rounded-lg {{ currentRoute starts with 'app_cart' or currentRoute starts with 'app_checkout' ? 'bg-amber-50 text-amber-700' : 'text-neutral-700' }}"
               aria-label="Voir le panier">
                <span class="sr-only">Panier</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.962-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/>
                </svg>
                {% if count > 0 %}
                    <span class="absolute -top-1 right-1 min-w-[1.1rem] h-4 px-1 rounded-full bg-amber-500 text-white text-[10px] font-bold flex items-center justify-center leading-none">
                        {{ count }}
                    </span>
                {% endif %}
            </a>
        </div>
    </nav>
</header>

<script>
    (function () {
        const header = document.querySelector('[data-site-header]');
        if (!header) {
            return;
        }

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const smoothLinks = header.querySelectorAll('a.js-smooth-scroll[href^="#"]');

        if (!prefersReducedMotion && smoothLinks.length > 0) {
            const duration = 700;
            const easeInOutCubic = (value) => {
                return value < 0.5
                    ? 4 * value * value * value
                    : 1 - Math.pow(-2 * value + 2, 3) / 2;
            };

            smoothLinks.forEach((link) => {
                link.addEventListener('click', (event) => {
                    const targetSelector = link.getAttribute('href');
                    if (!targetSelector || !targetSelector.startsWith('#')) {
                        return;
                    }

                    const target = document.querySelector(targetSelector);
                    if (!target) {
                        return;
                    }

                    event.preventDefault();

                    const headerHeight = header.getBoundingClientRect().height;
                    const startY = window.scrollY;
                    const targetY = targetSelector === '#top'
                        ? 0
                        : Math.max(0, target.getBoundingClientRect().top + window.scrollY - headerHeight - 12);
                    const distance = targetY - startY;
                    let startTime = null;

                    const step = (timestamp) => {
                        if (startTime === null) {
                            startTime = timestamp;
                        }

                        const elapsed = timestamp - startTime;
                        const progress = Math.min(elapsed / duration, 1);
                        const eased = easeInOutCubic(progress);

                        window.scrollTo(0, startY + distance * eased);

                        if (progress < 1) {
                            window.requestAnimationFrame(step);
                        }
                    };

                    window.requestAnimationFrame(step);
                    window.history.replaceState(null, '', targetSelector);
                });
            });
        }
    })();
</script>
