{#
  Header partagé pour toutes les pages publiques.

  Variables optionnelles :
  - back_route  : nom de route pour le lien "← Retour" (ex: 'app_catalog_index')
  - back_label  : libellé du lien retour (ex: '← Catalogue')
#}
{% set count = cart_count() %}
{% set currentRoute = app.request.attributes.get('_route') %}

<header class="bg-white border-b border-neutral-200 sticky top-0 z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">

        {# === GAUCHE : logo + lien retour optionnel === #}
        <div class="flex items-center gap-4 min-w-0">
            <a href="{{ path('app_home') }}" class="flex items-center gap-2 shrink-0">
                <img src="{{ asset('media/LOGO Kdos-graphie.svg') }}" alt="Kdos Graphie" class="h-9 w-auto">
                <span class="font-display text-lg tracking-wide text-neutral-900 hidden lg:inline">Kdos Graphie</span>
            </a>
            {% if back_route is defined and back_route %}
                <a href="{{ path(back_route) }}"
                   class="hidden sm:inline-flex items-center gap-1 text-sm text-neutral-500 hover:text-neutral-900 transition">
                    {{ back_label|default('← Retour') }}
                </a>
            {% endif %}
        </div>

        {# === DROITE : nav + badge panier === #}
        <nav class="hidden md:flex items-center gap-1 sm:gap-3" aria-label="Navigation principale">

            <a href="{{ path('app_catalog_index') }}"
               class="inline-block px-3 py-1.5 text-sm transition rounded-lg {{ currentRoute starts with 'app_catalog' ? 'text-amber-700 bg-amber-50 font-semibold' : 'text-neutral-600 hover:text-amber-700 hover:bg-neutral-50' }}">
                Catalogue
            </a>
            <a href="{{ path('app_contact') }}"
               class="inline-block px-3 py-1.5 text-sm transition rounded-lg {{ currentRoute == 'app_contact' ? 'text-amber-700 bg-amber-50 font-semibold' : 'text-neutral-600 hover:text-amber-700 hover:bg-neutral-50' }}">
                Contact
            </a>

            {# Séparateur visible sur sm+ #}
            <span class="hidden sm:block w-px h-5 bg-neutral-200 mx-1"></span>

            {# Panier avec badge #}
            <a href="{{ path('app_cart_index') }}"
               class="relative flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-neutral-700 hover:text-amber-700 transition rounded-lg hover:bg-neutral-50">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round"
                          d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.962-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/>
                </svg>
                <span class="hidden sm:inline">Panier</span>
                {% if count > 0 %}
                    <span class="absolute -top-1 -right-1 sm:static sm:ml-0.5
                                 min-w-[1.25rem] h-5 px-1 rounded-full
                                 bg-amber-500 text-white text-xs font-bold
                                 flex items-center justify-center leading-none">
                        {{ count }}
                    </span>
                {% endif %}
            </a>

        </nav>

        <details class="md:hidden relative">
            <summary class="list-none cursor-pointer inline-flex items-center justify-center w-10 h-10 rounded-lg border border-neutral-200 text-neutral-700 hover:text-amber-700 hover:border-amber-300">
                <span class="sr-only">Ouvrir le menu</span>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
                </svg>
            </summary>
            <div class="absolute right-0 mt-2 w-56 rounded-xl border border-neutral-200 bg-white shadow-xl p-2">
                <a href="{{ path('app_home') }}" class="block rounded-lg px-3 py-2 text-sm {{ currentRoute == 'app_home' ? 'bg-amber-50 text-amber-700 font-semibold' : 'text-neutral-700 hover:bg-neutral-50' }}">Accueil</a>
                <a href="{{ path('app_catalog_index') }}" class="block rounded-lg px-3 py-2 text-sm {{ currentRoute starts with 'app_catalog' ? 'bg-amber-50 text-amber-700 font-semibold' : 'text-neutral-700 hover:bg-neutral-50' }}">Catalogue</a>
                <a href="{{ path('app_contact') }}" class="block rounded-lg px-3 py-2 text-sm {{ currentRoute == 'app_contact' ? 'bg-amber-50 text-amber-700 font-semibold' : 'text-neutral-700 hover:bg-neutral-50' }}">Contact</a>
                <a href="{{ path('app_cart_index') }}" class="mt-1 flex items-center justify-between rounded-lg px-3 py-2 text-sm text-neutral-700 hover:bg-neutral-50">
                    <span>Panier</span>
                    {% if count > 0 %}
                        <span class="min-w-[1.25rem] h-5 px-1 rounded-full bg-amber-500 text-white text-xs font-bold flex items-center justify-center leading-none">{{ count }}</span>
                    {% endif %}
                </a>
            </div>
        </details>
    </div>

    <nav class="md:hidden border-t border-neutral-200" aria-label="Navigation rapide mobile">
        <div class="max-w-7xl mx-auto px-4 py-2 grid grid-cols-4 gap-2 text-xs">
            <a href="{{ path('app_home') }}" class="rounded-lg px-2 py-2 text-center {{ currentRoute == 'app_home' ? 'bg-amber-50 text-amber-700 font-semibold' : 'text-neutral-600' }}">Accueil</a>
            <a href="{{ path('app_catalog_index') }}" class="rounded-lg px-2 py-2 text-center {{ currentRoute starts with 'app_catalog' ? 'bg-amber-50 text-amber-700 font-semibold' : 'text-neutral-600' }}">Catalogue</a>
            <a href="{{ path('app_contact') }}" class="rounded-lg px-2 py-2 text-center {{ currentRoute == 'app_contact' ? 'bg-amber-50 text-amber-700 font-semibold' : 'text-neutral-600' }}">Contact</a>
            <a href="{{ path('app_cart_index') }}" class="rounded-lg px-2 py-2 text-center {{ currentRoute starts with 'app_cart' ? 'bg-amber-50 text-amber-700 font-semibold' : 'text-neutral-600' }}">
                Panier{% if count > 0 %} ({{ count }}){% endif %}
            </a>
        </div>
    </nav>
</header>
