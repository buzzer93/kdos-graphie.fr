{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié — KDOS-GRAPHIE{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
        <div class="text-center mb-8">
            <img src="{{ asset('media/LOGO Kdos-graphie.svg') }}" alt="KDOS-GRAPHIE" class="h-10 mx-auto mb-5">
            <h1 class="font-display text-2xl font-semibold text-neutral-900 tracking-tight">Mot de passe oublié</h1>
            <p class="text-sm text-neutral-500 mt-1.5">Entrez votre email, nous vous enverrons un lien de réinitialisation.</p>
        </div>

        <div class="bg-white rounded-[20px] px-8 py-8"
             style="box-shadow: rgba(0,0,0,0.02) 0px 0px 0px 1px, rgba(0,0,0,0.04) 0px 2px 6px, rgba(0,0,0,0.1) 0px 4px 8px;">

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 rounded-lg border px-4 py-3 text-sm {{ type == 'danger' ? 'border-red-200 bg-red-50 text-red-700' : 'border-emerald-200 bg-emerald-50 text-emerald-700' }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {{ form_start(form, {attr: {class: 'space-y-5'}}) }}
                <div>
                    {{ form_label(form.email, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
                    {{ form_widget(form.email, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm', placeholder: 'votre@email.com', autofocus: true}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <button type="submit" class="w-full bg-neutral-900 hover:bg-amber-500 text-white text-sm font-medium py-3 px-6 rounded-lg transition-colors duration-200">
                    Envoyer le lien
                </button>
            {{ form_end(form) }}
        </div>

        <p class="text-center text-xs text-neutral-400 mt-6">
            <a href="{{ path('app_login') }}" class="hover:text-neutral-600 transition-colors">← Retour à la connexion</a>
        </p>
    </div>
</div>
{% endblock %}
