{% extends 'base.html.twig' %}

{% block title %}Contact — Kdos Graphie{% endblock %}

{% block stylesheets %}
    {% if recaptchaSiteKey %}
        <script src="https://www.google.com/recaptcha/api.js?render={{ recaptchaSiteKey }}"></script>
    {% endif %}
{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50 text-neutral-800">
    <header class="bg-white border-b border-neutral-200">
        <div class="max-w-7xl mx-auto px-6 py-4">
            <a href="{{ path('app_home') }}" class="text-sm text-neutral-600 hover:text-neutral-900">← Retour à l'accueil</a>
        </div>
    </header>

    <main class="max-w-2xl mx-auto px-6 py-12">
        <h1 class="font-display text-4xl text-neutral-900 mb-2">Contactez-nous</h1>
        <p class="text-neutral-500 mb-8">Une question, un projet sur mesure ? Ecrivez-nous.</p>

        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="mb-6 rounded-lg border px-4 py-3 text-sm {{ type == 'danger' ? 'border-red-200 bg-red-50 text-red-700' : 'border-emerald-200 bg-emerald-50 text-emerald-700' }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        {{ form_start(form, {attr: {class: 'space-y-5', id: 'contact-form'}}) }}
            <input type="hidden" name="recaptcha_token" id="recaptcha_token">

            <div>
                {{ form_label(form.name, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
                {{ form_widget(form.name, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm'}}) }}
                {{ form_errors(form.name) }}
            </div>

            <div>
                {{ form_label(form.email, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
                {{ form_widget(form.email, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm'}}) }}
                {{ form_errors(form.email) }}
            </div>

            <div>
                {{ form_label(form.subject, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
                {{ form_widget(form.subject, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm'}}) }}
                {{ form_errors(form.subject) }}
            </div>

            <div>
                {{ form_label(form.message, null, {label_attr: {class: 'block text-sm font-medium text-neutral-700 mb-1.5'}}) }}
                {{ form_widget(form.message, {attr: {class: 'w-full px-4 py-3 border border-neutral-200 rounded-lg text-sm min-h-32'}}) }}
                {{ form_errors(form.message) }}
            </div>

            <button type="submit" class="bg-neutral-900 text-white text-sm font-semibold px-5 py-3 rounded-lg hover:bg-neutral-700">
                Envoyer le message
            </button>
        {{ form_end(form) }}

        {% if recaptchaSiteKey %}
            <script>
                (function () {
                    const form = document.getElementById('contact-form');
                    if (!form) return;
                    form.addEventListener('submit', function (e) {
                        e.preventDefault();
                        grecaptcha.ready(function () {
                            grecaptcha.execute('{{ recaptchaSiteKey }}', {action: 'contact'}).then(function (token) {
                                document.getElementById('recaptcha_token').value = token;
                                form.submit();
                            });
                        });
                    });
                })();
            </script>
        {% endif %}
    </main>
</div>
{% endblock %}
