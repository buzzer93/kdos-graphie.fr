{% extends 'base.html.twig' %}

{% block title %}Kdos Graphie — Gravure laser artisanale & cadeaux personnalisés{% endblock %}

{% block body %}
<div id="top" class="bg-white text-neutral-800">
    {{ include('partials/_header_public.html.twig') }}

    {# =================== HERO =================== #}
    <section class="relative flex items-center overflow-hidden bg-gradient-to-br from-amber-50 via-white to-neutral-50">
        {# Image de fond en filigrane #}
        <div class="absolute inset-0">
              <img src="{{ asset('media/gravure-laser-bois.jpg') }}"
                 alt=""
                  class="w-full h-full object-cover opacity-80">
              <div class="absolute inset-0 bg-gradient-to-b from-white/30 via-white/45 to-white"></div>
        </div>

        {# Décors ambiance #}
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-200 rounded-full blur-3xl opacity-40"></div>
        <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-orange-200 rounded-full blur-3xl opacity-40"></div>

        <div class="relative max-w-7xl mx-auto px-6 py-16 pt-32 md:py-20 md:pt-32 w-full grid md:grid-cols-2 gap-4 lg:gap-8 items-center">
            {# Colonne gauche : texte + CTA #}
            <div class="text-center md:text-left order-2 md:order-1">
                <span class="inline-flex items-center gap-2 bg-white border border-amber-200 text-amber-700 text-xs uppercase tracking-[0.2em] px-4 py-1.5 rounded-full shadow-sm">
                    <span class="w-1.5 h-1.5 bg-amber-500 rounded-full animate-pulse"></span>
                    Fait main · Atelier artisanal
                </span>

                <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mt-6 text-neutral-900">
                    Conçu pour vous, <span class="text-amber-600">gravé à la main.</span>
                </h1>
                <p class="mt-6 text-lg text-neutral-600 leading-relaxed max-w-xl md:max-w-none mx-auto md:mx-0">
                    Pas de série, pas de catalogue standard. Chaque pièce naît d'une idée — la vôtre — façonnée sur mesure dans notre atelier avec soin et précision laser.
                </p>

                <div class="mt-10 flex flex-wrap gap-4 justify-center md:justify-start">
                    <a href="{{ path('app_catalog_index') }}" class="bg-amber-500 hover:bg-amber-600 text-white font-semibold px-7 py-3.5 rounded-full transition shadow-xl shadow-amber-500/30">
                        Découvrir nos créations
                    </a>
                    <a href="#services" class="border border-neutral-300 text-neutral-800 hover:border-amber-500 hover:text-amber-600 font-semibold px-7 py-3.5 rounded-full transition bg-white/70">
                        Nos services
                    </a>
                </div>

                <div class="mt-14 flex items-center justify-center md:justify-start gap-8 text-sm">
                    <div>
                        <p class="font-display text-3xl font-bold text-amber-600">+500</p>
                        <p class="text-neutral-500">Créations uniques</p>
                    </div>
                    <div class="w-px h-10 bg-neutral-300"></div>
                    <div>
                        <p class="font-display text-3xl font-bold text-amber-600">100%</p>
                        <p class="text-neutral-500">Fait main</p>
                    </div>
                    <div class="w-px h-10 bg-neutral-300"></div>
                    <div>
                        <p class="font-display text-3xl font-bold text-amber-600">48h</p>
                        <p class="text-neutral-500">Délai express</p>
                    </div>
                </div>
            </div>

            <div class="order-1 md:order-2 flex justify-center md:justify-center">
                <div class="relative">
                    <div class="absolute inset-0 bg-amber-300/40 rounded-full blur-3xl"></div>
                    <img src="{{ asset('media/LOGO Kdos-graphie.svg') }}"
                         alt="Kdos Graphie"
                         class="relative h-40 md:h-56 lg:h-64 w-auto">
                </div>
            </div>
        </div>
    </section>

    {# =================== SERVICES =================== #}
    <section id="services" class="py-24 bg-neutral-50 border-t border-neutral-100 scroll-mt-28">
        <div class="max-w-7xl mx-auto px-6">
            <div class="max-w-2xl mx-auto text-center mb-16">
                <p class="uppercase tracking-[0.25em] text-amber-600 text-xs font-semibold">Notre savoir-faire</p>
                <h2 class="font-display text-4xl md:text-5xl font-bold text-neutral-900 mt-3">
                    Des créations uniques, à votre image
                </h2>
                <p class="text-neutral-600 mt-4 leading-relaxed">
                    Chaque projet est pensé et réalisé à la main dans notre atelier, selon vos envies et vos matériaux — pas selon un catalogue.
                </p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% set services = [
                    { icon: '🎁', titre: 'Cadeaux personnalisés', desc: 'Une idée, un message, un souvenir. On grave ce qui compte vraiment pour vous — pour un anniversaire, un mariage, une naissance.' },
                    { icon: '🏷️', titre: 'Gravure sur bois', desc: 'Chêne, hêtre, noyer. La chaleur du bois naturel sublimée par une gravure artisanale, précise et durable.' },
                    { icon: '🥃', titre: 'Gravure sur verre', desc: 'Verres, carafes, bouteilles : une finition raffinée, réalisée à la main pour vos événements les plus précieux.' },
                    { icon: '💼', titre: 'Objets professionnels', desc: 'Trophées, plaques, goodies : votre image de marque gravée sur mesure, dans notre atelier.' },
                    { icon: '🧵', titre: 'Cuir & textile', desc: 'Portefeuilles, carnets, ceintures : la personnalisation haut de gamme du cuir véritable, pièce par pièce.' },
                    { icon: '⚡', titre: 'Prototypage rapide', desc: 'Du fichier à l\'objet unique en 48h. On travaille à votre rythme, sur votre projet, pas sur une ligne de production.' }
                ] %}

                {% for s in services %}
                    <div class="group bg-white p-8 rounded-2xl border border-neutral-200 hover:border-amber-400 hover:shadow-2xl hover:shadow-amber-500/10 hover:-translate-y-1 transition-all duration-300">
                        <div class="w-14 h-14 rounded-xl bg-amber-50 group-hover:bg-amber-500 flex items-center justify-center text-2xl transition">
                            {{ s.icon }}
                        </div>
                        <h3 class="font-display text-xl font-bold text-neutral-900 mt-6">{{ s.titre }}</h3>
                        <p class="text-neutral-600 mt-3 leading-relaxed">{{ s.desc }}</p>
                        <a href="#contact" class="inline-flex items-center gap-2 mt-5 text-sm font-semibold text-amber-600 group-hover:gap-3 transition-all">
                            En savoir plus
                            <span>→</span>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# =================== CAROUSEL PRODUITS =================== #}
    <section id="produits" class="py-24 bg-white overflow-hidden">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
                <div>
                    <p class="uppercase tracking-[0.25em] text-amber-600 text-xs font-semibold">Nos créations</p>
                    <h2 class="font-display text-4xl md:text-5xl font-bold mt-3 text-neutral-900">Produits phares</h2>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex gap-3">
                        <button id="prev-btn" aria-label="Précédent" class="w-12 h-12 rounded-full border border-neutral-300 text-neutral-700 hover:border-amber-500 hover:bg-amber-500 hover:text-white transition flex items-center justify-center">
                            ←
                        </button>
                        <button id="next-btn" aria-label="Suivant" class="w-12 h-12 rounded-full border border-neutral-300 text-neutral-700 hover:border-amber-500 hover:bg-amber-500 hover:text-white transition flex items-center justify-center">
                            →
                        </button>
                    </div>
                    <a href="{{ path('app_catalog_index') }}" class="text-sm font-semibold text-amber-600 hover:text-amber-700 transition">
                        Voir tout →
                    </a>
                </div>
            </div>

            {% if products is not empty %}
                <div id="carousel" class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-4 -mx-6 px-6 [&::-webkit-scrollbar]:hidden" style="scrollbar-width:none;">
                    {% for product in products %}
                        <article class="snap-start flex-shrink-0 w-72 md:w-80 bg-white rounded-2xl overflow-hidden border border-neutral-200 group hover:shadow-2xl hover:shadow-amber-500/10 hover:-translate-y-1 hover:border-amber-400 transition">
                            <a href="{{ path('app_catalog_show', {slug: product.slug}) }}" class="block">
                                <div class="relative h-72 overflow-hidden bg-neutral-100">
                                    {% if product.coverImage %}
                                        <img src="{{ asset('assets/media/products/' ~ product.coverImage) }}" alt="{{ product.name }}" class="w-full h-full object-cover group-hover:scale-110 transition duration-700">
                                    {% else %}
                                        <div class="w-full h-full flex items-center justify-center">
                                            <img src="{{ asset('media/LOGO Kdos-graphie.svg') }}" alt="Kdos Graphie" class="h-20 w-auto opacity-20">
                                        </div>
                                    {% endif %}
                                    {% if product.category %}
                                        <span class="absolute top-4 left-4 bg-white/90 backdrop-blur text-neutral-800 text-xs uppercase tracking-wider px-3 py-1 rounded-full shadow-sm">{{ product.category.name }}</span>
                                    {% endif %}
                                </div>
                                <div class="p-6">
                                    <div class="flex items-center justify-between gap-3">
                                        <h3 class="font-display text-lg font-semibold text-neutral-900 truncate">{{ product.name }}</h3>
                                        <p class="text-amber-600 font-bold whitespace-nowrap">{{ (product.price / 100)|number_format(2, ',', ' ') }} €</p>
                                    </div>
                                    <p class="text-sm text-neutral-500 mt-2">Personnalisation incluse</p>
                                </div>
                            </a>
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-neutral-500 text-center py-12">Aucun produit disponible pour le moment.</p>
            {% endif %}
        </div>
    </section>

    {# =================== CTA CONTACT =================== #}
    <section id="contact" class="py-24 bg-gradient-to-br from-amber-500 to-amber-600 text-white">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2 class="font-display text-4xl md:text-5xl font-bold">Une idée ? Parlons-en.</h2>
            <p class="mt-4 text-white/90 text-lg leading-relaxed max-w-2xl mx-auto">
                Décrivez-nous ce que vous avez en tête. On vous répond sous 24h avec un devis sur mesure, fait sur la base de votre projet — pas d'un catalogue.
            </p>
            <div class="mt-10 flex flex-wrap gap-4 justify-center">
                <a href="{{ path('app_contact') }}" class="bg-white hover:bg-neutral-100 text-amber-700 font-semibold px-8 py-4 rounded-full transition shadow-xl">
                    Envoyer un message
                </a>
                <a href="tel:+33612098358" class="bg-white/10 hover:bg-white/20 backdrop-blur border border-white/40 font-semibold px-8 py-4 rounded-full transition">
                    06 12 09 83 58
                </a>
            </div>
        </div>
    </section>

    {# =================== FOOTER =================== #}
    <footer class="bg-neutral-100 text-neutral-600 py-12 border-t border-neutral-200">
        <div class="max-w-7xl mx-auto px-6 flex flex-wrap items-center justify-between gap-4 text-sm">
            <div class="flex items-center gap-3">
                <img src="{{ asset('media/LOGO Kdos-graphie.svg') }}" alt="Kdos Graphie" class="h-8 w-auto">
                <span class="font-display text-neutral-900">Kdos Graphie</span>
            </div>
            <p>© {{ "now"|date("Y") }} Kdos Graphie — Artisan graveur laser. Tous droits réservés.</p>
            <nav class="flex items-center gap-5">
                <a href="{{ path('app_catalog_index') }}" class="hover:text-amber-600 transition">Catalogue</a>
                <a href="{{ path('app_contact') }}" class="hover:text-amber-600 transition">Contact</a>
                <a href="{{ path('app_login') }}" class="hover:text-amber-600 transition">Espace admin</a>
            </nav>
        </div>
    </footer>
</div>

<script>
    (function () {
        const carousel = document.getElementById('carousel');
        const prev = document.getElementById('prev-btn');
        const next = document.getElementById('next-btn');
        if (!carousel) return;
        const step = () => Math.min(carousel.clientWidth * 0.8, 340);
        prev?.addEventListener('click', () => carousel.scrollBy({ left: -step(), behavior: 'smooth' }));
        next?.addEventListener('click', () => carousel.scrollBy({ left: step(), behavior: 'smooth' }));
    })();
</script>
{% endblock %}
