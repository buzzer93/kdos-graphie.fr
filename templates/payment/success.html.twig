{% extends 'base.html.twig' %}

{% block title %}Paiement confirmé — Kdos Graphie{% endblock %}

{% block body %}
<div class="min-h-screen bg-neutral-50 text-neutral-800 flex items-center justify-center px-6">
    <div class="max-w-2xl w-full bg-white border border-neutral-200 rounded-2xl p-8 text-center space-y-4">
        <div class="flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mx-auto">
            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
        </div>

        <h1 class="font-display text-4xl text-neutral-900">Paiement reçu</h1>

        {% if order %}
        <p class="text-neutral-700">
            Merci ! Votre paiement pour la commande <strong>{{ order.reference }}</strong> a bien été reçu.
        </p>
        <p class="text-neutral-600 text-sm">
            L'atelier va prendre en charge votre commande. Vous recevrez un email de confirmation.
        </p>
        {% else %}
        <p class="text-neutral-600">Votre paiement a bien été pris en compte.</p>
        {% endif %}

        <div class="pt-2 flex flex-wrap gap-3 justify-center">
            <a href="{{ path('app_catalog_index') }}" class="inline-flex bg-neutral-900 text-white text-sm font-semibold px-4 py-2.5 rounded-lg hover:bg-amber-600 transition">
                Retour au catalogue
            </a>
            <a href="{{ path('app_contact') }}" class="inline-flex border border-neutral-300 text-neutral-700 text-sm font-semibold px-4 py-2.5 rounded-lg hover:border-amber-500 hover:text-amber-600 transition">
                Nous contacter
            </a>
        </div>
    </div>
</div>
{% endblock %}
